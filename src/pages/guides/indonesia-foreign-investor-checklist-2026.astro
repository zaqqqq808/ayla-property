---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_URL } from '@/config';
import Header from '@/components/Header.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import Footer from '@/components/Footer.astro';
import StickyButton from '@/components/StickyButton.astro';
import CalendlyButton from '@/components/CalendlyButton.astro';

const sections = [
  { id: 'regulatory-overview', label: '2026 Regulatory Overview' },
  { id: 'visa-checklist',      label: 'Visa and Residency' },
  { id: 'ownership-checklist', label: 'Ownership Structures' },
  { id: 'licensing-checklist', label: 'Licensing and Compliance' },
  { id: 'due-diligence',       label: 'Due Diligence' },
  { id: 'tax-financial',       label: 'Tax and Finance' },
  { id: 'key-dates',           label: 'Key 2026 Dates' },
];

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
    { "@type": "ListItem", "position": 2, "name": "Indonesia Foreign Investor Checklist 2026", "item": `${SITE_URL}/guides/indonesia-foreign-investor-checklist-2026/` },
  ]
});

const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Indonesia Foreign Investor Checklist 2026: Visas, Property, Licensing and Compliance",
  "description": "The complete 2026 regulatory checklist for foreign investors buying property in Indonesia and Bali. Covers new KBLI licensing rules, Golden Visa thresholds, PT PMA capital changes, and OTA compliance deadlines.",
  "author": { "@type": "Organization", "name": "Ayla Property", "url": SITE_URL },
  "publisher": { "@type": "Organization", "name": "Ayla Property", "logo": { "@type": "ImageObject", "url": `${SITE_URL}/logo.png` } },
  "datePublished": "2026-06-01",
  "dateModified": "2026-06-01",
  "url": `${SITE_URL}/guides/indonesia-foreign-investor-checklist-2026/`,
});
---

<BaseLayout
  title="Indonesia Foreign Investor Checklist 2026 | Visas, Property, Licensing | Ayla Property"
  description="The complete 2026 regulatory checklist for foreign investors in Indonesia. Covers new KBLI licensing rules, Golden Visa thresholds, PT PMA changes, Second Home Visa, and OTA compliance deadlines."
  ogType="article"
  ogImage="/og-guide.jpg"
>
  <Fragment slot="head">
    <Fragment set:html={`<script type="application/ld+json">${breadcrumbSchema}</script>`} />
    <Fragment set:html={`<script type="application/ld+json">${articleSchema}</script>`} />
  </Fragment>

  <Header />

  <!-- Hero -->
  <section class="relative bg-brown pt-40 pb-16 px-6 lg:px-12 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/hero-villa.jpg')] bg-cover bg-center opacity-20"></div>
    <div class="relative max-w-4xl mx-auto text-center">
      <p class="text-gold uppercase tracking-widest text-sm font-semibold mb-4">Regulatory Guide · June 2026</p>
      <h1 class="text-white text-4xl md:text-5xl lg:text-6xl font-display uppercase leading-tight mb-6">
        Indonesia Foreign<br />Investor Checklist 2026
      </h1>
      <p class="text-white/75 text-lg max-w-2xl mx-auto mb-8">
        Indonesia's most significant property and investment regulations in a decade came into effect in 2025 and 2026. This checklist covers every requirement foreign investors must meet: visas, ownership structures, licensing, compliance deadlines, and due diligence.
      </p>
      <p class="text-gold/80 text-xs uppercase tracking-widest">Last updated June 2026 · Free to cite with attribution to Ayla Property</p>
      <div class="flex items-center justify-center gap-3 mt-6">
        <img src="/images/team-zaq.webp" alt="Zaq Qureshi" class="w-10 h-10 rounded-full object-cover border-2 border-white/30" />
        <div class="text-left">
          <p class="text-white text-sm font-semibold">Zaq Qureshi</p>
          <p class="text-white/60 text-xs">Bali property broker · Founder, Ayla Property · Based in Bali since 2023</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Alert bar -->
  <div class="bg-gold/10 border-b border-gold/30 py-4 px-6">
    <div class="max-w-4xl mx-auto flex items-start gap-3">
      <svg class="w-5 h-5 text-gold-dark shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
      <p class="text-brown text-sm"><strong>Key deadline:</strong> All short-term rental properties operating on OTA platforms (Airbnb, Booking.com, Expedia) were required to hold a valid NIB business licence by March 2026. Properties without verified licensing face delisting.</p>
    </div>
  </div>

  <!-- Main content -->
  <div class="bg-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 py-16 lg:py-24 flex flex-col lg:flex-row gap-12 lg:gap-16">

      <!-- Sticky sidebar -->
      <aside class="lg:w-64 shrink-0">
        <div class="lg:sticky lg:top-8">
          <p class="text-gold-dark uppercase tracking-widest text-xs font-semibold mb-4">Sections</p>
          <nav class="space-y-1" aria-label="Checklist sections">
            {sections.map(s => (
              <a href={`#${s.id}`} class="toc-link block text-sm text-brown/60 hover:text-olive py-1.5 border-l-2 border-transparent hover:border-olive pl-3 transition-all duration-150">{s.label}</a>
            ))}
          </nav>
          <div class="mt-8 p-4 bg-white rounded-xl border border-beige text-center">
            <p class="text-brown text-sm font-semibold mb-1">Questions about compliance?</p>
            <p class="text-brown/60 text-xs mb-3">Book a free call with Ayla</p>
            <CalendlyButton text="Free Consultation" variant="brown" />
          </div>
          <a href="/guides/foreigners-buying-property-bali/" class="mt-4 flex items-center justify-center gap-2 w-full border border-gold/50 text-gold-dark hover:bg-gold/10 text-xs uppercase tracking-widest font-semibold px-4 py-3 rounded-sm transition-colors">
            Full Buyers Guide &rarr;
          </a>
        </div>
      </aside>

      <!-- Article body -->
      <article class="flex-1 max-w-3xl guide-content">

        <!-- Regulatory Overview -->
        <section id="regulatory-overview" class="guide-section mb-16">
          <h2>2026 Regulatory Overview</h2>
          <p>Three major regulatory shifts came into force in 2025 and 2026. If you own or are buying property in Bali, all three affect you directly.</p>

          <div class="not-prose grid gap-4 mt-6">

            <div class="bg-white border border-beige rounded-xl p-6">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-brown/10 flex items-center justify-center shrink-0">
                  <span class="text-brown font-bold text-sm">1</span>
                </div>
                <div class="flex-1">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <p class="font-semibold text-brown text-base">New Business Classification Codes (KBLI 2025)</p>
                    <span class="text-xs bg-gold/20 text-gold-dark px-2 py-0.5 rounded font-semibold uppercase tracking-wide">Dec 2025</span>
                  </div>
                  <p class="text-sm text-brown/70 mb-3">BPS Regulation No. 7/2025 introduced a revised business classification system. Every PT PMA operating in property or accommodation must update its KBLI codes by June 2026. Key new codes:</p>
                  <div class="grid grid-cols-2 gap-2 mb-3">
                    <div class="flex items-center gap-2 bg-cream rounded-lg px-3 py-2"><span class="text-xs font-bold text-olive">KBLI 55203</span><span class="text-xs text-brown/60">Villa Activity</span></div>
                    <div class="flex items-center gap-2 bg-cream rounded-lg px-3 py-2"><span class="text-xs font-bold text-olive">KBLI 55106</span><span class="text-xs text-brown/60">Non-Star Hotel</span></div>
                    <div class="flex items-center gap-2 bg-cream rounded-lg px-3 py-2"><span class="text-xs font-bold text-olive">KBLI 55204</span><span class="text-xs text-brown/60">Serviced Apartment</span></div>
                    <div class="flex items-center gap-2 bg-cream rounded-lg px-3 py-2"><span class="text-xs font-bold text-olive">KBLI 55209</span><span class="text-xs text-brown/60">Glamping</span></div>
                  </div>
                  <p class="text-xs text-brown/50 italic">Operating a villa rental under an incorrect or outdated code is now a compliance violation, not a technicality.</p>
                </div>
              </div>
            </div>

            <div class="bg-white border border-beige rounded-xl p-6">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-olive/10 flex items-center justify-center shrink-0">
                  <span class="text-olive font-bold text-sm">2</span>
                </div>
                <div class="flex-1">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <p class="font-semibold text-brown text-base">PT PMA Minimum Capital Cut by 75%</p>
                    <span class="text-xs bg-olive/20 text-olive px-2 py-0.5 rounded font-semibold uppercase tracking-wide">Ongoing</span>
                  </div>
                  <p class="text-sm text-brown/70 mb-3">BKPM Regulation 5/2025 reduced the upfront paid-up capital requirement from IDR 10 billion to IDR 2.5 billion. Important: the company must still outline a Total Investment Plan of IDR 10 billion per KBLI code. For property, land and building acquisition costs count toward this 10 billion target.</p>
                  <div class="flex items-center gap-6 bg-cream rounded-xl px-5 py-4">
                    <div class="text-center">
                      <p class="text-lg font-bold text-brown/40 line-through">IDR 10B</p>
                      <p class="text-xs text-brown/40 mt-1">Old requirement</p>
                    </div>
                    <svg class="w-5 h-5 text-olive shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
                    <div class="text-center">
                      <p class="text-lg font-bold text-olive">IDR 2.5B</p>
                      <p class="text-xs text-brown/60 mt-1">New requirement</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-white border border-red-200 rounded-xl p-6">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center shrink-0">
                  <span class="text-red-500 font-bold text-sm">3</span>
                </div>
                <div class="flex-1">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <p class="font-semibold text-brown text-base">OTA Platform Licensing Enforcement</p>
                    <span class="text-xs bg-red-100 text-red-600 px-2 py-0.5 rounded font-semibold uppercase tracking-wide">Deadline Passed</span>
                  </div>
                  <p class="text-sm text-brown/70 mb-3">From March 2026, Airbnb, Booking.com, and Expedia require a verified NIB (business registration number) for all listed properties. Unlicensed properties face immediate removal.</p>
                  <div class="flex flex-wrap gap-2 mb-3">
                    <span class="text-xs bg-red-50 text-red-600 border border-red-200 px-3 py-1 rounded-full font-semibold">Airbnb</span>
                    <span class="text-xs bg-red-50 text-red-600 border border-red-200 px-3 py-1 rounded-full font-semibold">Booking.com</span>
                    <span class="text-xs bg-red-50 text-red-600 border border-red-200 px-3 py-1 rounded-full font-semibold">Expedia</span>
                  </div>
                  <p class="text-xs text-red-500 font-semibold">If you are listing on any of these platforms without a valid NIB, you are at risk of delisting right now.</p>
                </div>
              </div>
            </div>

          </div>
        </section>

        <!-- Visa Checklist -->
        <section id="visa-checklist" class="guide-section mb-16">
          <h2>Visa and Residency Checklist</h2>
          <p>Indonesia now offers three distinct long-stay pathways for foreign property investors. The right choice depends on your investment size, intended use, and whether you plan to reside in Indonesia.</p>

          <h3>Golden Visa (E28C) — Updated 2026 Thresholds</h3>
          <div class="overflow-x-auto mt-4">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="bg-brown text-white">
                  <th class="text-left px-4 py-3 font-semibold">Visa Type</th>
                  <th class="text-left px-4 py-3 font-semibold">Duration</th>
                  <th class="text-left px-4 py-3 font-semibold">Investment Requirement</th>
                  <th class="text-left px-4 py-3 font-semibold">Eligible Instruments</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b border-beige bg-white">
                  <td class="px-4 py-3 font-semibold">Golden Visa (Individual)</td>
                  <td class="px-4 py-3">5 years</td>
                  <td class="px-4 py-3">USD $350,000</td>
                  <td class="px-4 py-3">Government bonds, IDX shares, mutual funds</td>
                </tr>
                <tr class="border-b border-beige bg-cream/50">
                  <td class="px-4 py-3 font-semibold">Golden Visa (Individual)</td>
                  <td class="px-4 py-3">10 years</td>
                  <td class="px-4 py-3">USD $700,000</td>
                  <td class="px-4 py-3">Government bonds, IDX shares, or residential apartment</td>
                </tr>
                <tr class="border-b border-beige bg-white">
                  <td class="px-4 py-3 font-semibold">Golden Visa (Property Route)</td>
                  <td class="px-4 py-3">10 years</td>
                  <td class="px-4 py-3">USD $1,000,000+</td>
                  <td class="px-4 py-3">Residential apartment purchase</td>
                </tr>
                <tr class="border-b border-beige bg-cream/50">
                  <td class="px-4 py-3 font-semibold">Second Home Visa</td>
                  <td class="px-4 py-3">5 years (renewable)</td>
                  <td class="px-4 py-3">IDR 2 billion (~USD $130,000)</td>
                  <td class="px-4 py-3">Property ownership OR bank deposit</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 class="mt-8">Visa Checklist</h3>
          <div class="space-y-3 mt-4">
            {[
              "Determine which visa pathway matches your investment size and residency intention",
              "For Golden Visa: confirm your investment instrument qualifies (government bonds, IDX-listed shares, mutual funds registered with OJK, or qualifying residential apartment)",
              "For Second Home Visa: confirm property value meets IDR 2 billion minimum OR prepare equivalent bank deposit documentation",
              "Apply through the Directorate General of Immigration (imigrasi.go.id) or authorised immigration consultants",
              "Note: Golden Visa is renewable and does not grant permanent residency. KITAP (permanent stay permit) follows a separate pathway",
              "Investor KITAS holders should verify their visa category is compatible with property ownership activities",
              "Check whether your nationality requires a sponsor letter and which Indonesian authority is the appropriate sponsor for investor visas",
            ].map(item => (
              <label class="flex items-start gap-3 p-3 bg-white rounded-lg border border-beige cursor-pointer hover:border-olive transition-colors group checklist-item">
                <div class="w-5 h-5 rounded border-2 border-olive shrink-0 mt-0.5 flex items-center justify-center transition-colors checkbox-box">
                  <svg class="w-3 h-3 text-white hidden check-icon" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <p class="text-sm text-brown group-[.checked]:line-through group-[.checked]:text-brown/40 transition-all">{item}</p>
              </label>
            ))}
          </div>
        </section>

        <!-- Ownership Structures -->
        <section id="ownership-checklist" class="guide-section mb-16">
          <h2>Ownership Structure Checklist</h2>
          <p>Foreign nationals cannot hold Hak Milik (freehold) title directly. The two compliant structures are leasehold (Hak Sewa / Hak Pakai) and the PT PMA route for Hak Guna Bangunan. Selecting the wrong structure at purchase is expensive to unwind.</p>

          <h3>Leasehold (Hak Sewa / Hak Pakai)</h3>
          <div class="space-y-3 mt-4">
            {[
              "Confirm the lease term: minimum recommended is 25 years initial term with a contracted right of renewal for a further 25 years",
              "Verify the renewal clause is explicit, not implied: the renewal price formula must be defined in the original agreement, not left to future negotiation",
              "Confirm the lease is notarised by a qualified PPAT (Pejabat Pembuat Akta Tanah) notary",
              "Understand your registration rights by title type: if utilising Hak Pakai (Right to Use), confirm the title is officially registered with the BPN (Badan Pertanahan Nasional). If utilising a standard Hak Sewa leasehold, ensure the contract is fully notarised by a reputable notary public. Note: standard Hak Sewa agreements are contractual rights under Indonesian civil law (UUPA 1960) and are not recorded directly on the BPN land registry. Full notarisation remains essential for legal enforceability",
              "Verify transferability: the agreement must grant you the explicit right to sell or transfer the lease without requiring the landowner's approval (or with approval not to be unreasonably withheld)",
              "Check for force majeure and government compulsory acquisition clauses: compensation must flow to the leaseholder, not the landowner",
              "Avoid nominee arrangements: these have no legal recognition under Indonesian law and cannot be enforced in Indonesian courts",
            ].map(item => (
              <label class="flex items-start gap-3 p-3 bg-white rounded-lg border border-beige cursor-pointer hover:border-olive transition-colors group checklist-item">
                <div class="w-5 h-5 rounded border-2 border-olive shrink-0 mt-0.5 flex items-center justify-center transition-colors checkbox-box">
                  <svg class="w-3 h-3 text-white hidden check-icon" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <p class="text-sm text-brown group-[.checked]:line-through group-[.checked]:text-brown/40 transition-all">{item}</p>
              </label>
            ))}
          </div>

          <h3 class="mt-8">PT PMA (Foreign-Owned Company)</h3>
          <div class="space-y-3 mt-4">
            {[
              "Confirm PT PMA is registered with BKPM (OSS system) with the correct KBLI codes for your intended property activity",
              "New 2026 requirement: upfront paid-up capital minimum is IDR 2.5 billion (reduced from IDR 10 billion under BKPM Regulation 5/2025). Note: the company must still present a Total Investment Plan of IDR 10 billion per KBLI code. For property investors, the value of land and building acquisition counts toward this 10 billion requirement",
              "Ensure your KBLI registration matches your actual business activity: KBLI 55203 for villa operations, KBLI 55193 for villa rental, or appropriate accommodation codes",
              "Register for Indonesian tax (NPWP) in the PT PMA's name",
              "Open a corporate bank account with an Indonesian bank in the PT PMA's name for rental income receipt",
              "Appoint a local director if required by your business activity classification",
              "Conduct annual compliance: financial reporting, tax filing, and company secretarial obligations",
              "For existing PT PMAs: verify your KBLI codes align with KBLI 2025 classifications by June 2026 (6-month transition from December 2025 publication date)",
            ].map(item => (
              <label class="flex items-start gap-3 p-3 bg-white rounded-lg border border-beige cursor-pointer hover:border-olive transition-colors group checklist-item">
                <div class="w-5 h-5 rounded border-2 border-olive shrink-0 mt-0.5 flex items-center justify-center transition-colors checkbox-box">
                  <svg class="w-3 h-3 text-white hidden check-icon" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <p class="text-sm text-brown group-[.checked]:line-through group-[.checked]:text-brown/40 transition-all">{item}</p>
              </label>
            ))}
          </div>
        </section>

        <!-- Licensing and Compliance -->
        <section id="licensing-checklist" class="guide-section mb-16">
          <h2>Licensing and Compliance Checklist</h2>
          <p>This is the area of most significant change in 2025 and 2026. Operating a rental property without the correct licences is now an enforced compliance risk, not merely a theoretical one.</p>

          <div class="callout mb-6">
            <strong>Critical note:</strong> Foreigners cannot legally hold a Pondok Wisata (homestay) licence. Under Permenpar 18/2016, this licence is restricted to Indonesian citizens. The compliant route for foreign-owned rental villas is a PT PMA holding KBLI 55203 (Villa Activity) or KBLI 55193 (Villa Rental).
          </div>

          <div class="space-y-3">
            {[
              "Obtain a NIB (Nomor Induk Berusaha) through the OSS (Online Single Submission) system at oss.go.id: this is the primary business registration number required for all OTA platform listings",
              "Obtain the correct accommodation licence for your property type: Villa licence (KBLI 55203) for villas, not a Pondok Wisata (which requires Indonesian citizenship)",
              "Obtain TDUP (Tanda Daftar Usaha Pariwisata): tourism business registration, required for any accommodation offering short-stay rentals",
              "Confirm your building permit (PBG, formerly IMB) is valid and matches the current use of the property",
              "Confirm zoning (RTRW): the land must be zoned for commercial or tourism use, not agricultural. Villas on agricultural-zoned land cannot legally be rented out",
              "Existing OTA operators: verify your NIB has been submitted to and verified by your OTA platforms (Airbnb, Booking.com, Expedia) before the March 2026 enforcement deadline",
              "Obtain a valid environmental permit (UKL-UPL or SPPL) if your development exceeds the threshold for environmental impact assessment",
              "Register for Pajak Hotel dan Restoran (Hotel and Restaurant Tax) with your local Badan Pendapatan Daerah if collecting accommodation tax from guests",
            ].map(item => (
              <label class="flex items-start gap-3 p-3 bg-white rounded-lg border border-beige cursor-pointer hover:border-olive transition-colors group checklist-item">
                <div class="w-5 h-5 rounded border-2 border-olive shrink-0 mt-0.5 flex items-center justify-center transition-colors checkbox-box">
                  <svg class="w-3 h-3 text-white hidden check-icon" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <p class="text-sm text-brown group-[.checked]:line-through group-[.checked]:text-brown/40 transition-all">{item}</p>
              </label>
            ))}
          </div>
        </section>

        <!-- Due Diligence -->
        <section id="due-diligence" class="guide-section mb-16">
          <h2>Due Diligence Checklist</h2>
          <p>The steps below apply to every property purchase, regardless of structure. Skipping any one of them is the most common cause of Bali property disputes.</p>

          <div class="space-y-3">
            {[
              "Instruct an independent PPAT notary (not the developer's notary) to run a full title check on the land certificate (sertifikat tanah)",
              "Verify the land certificate is free of encumbrances, liens, or disputes via the BPN database",
              "Confirm the seller has the legal authority to sell: for company-owned land, verify company directors' authority and obtain corporate resolutions",
              "Check the building permit (PBG) is valid, correctly names the owner, and matches the actual built footprint",
              "Confirm zoning status with the local DPMPTSP (investment and licensing agency): tourist accommodation zones, residential zones, and agricultural zones carry different legal permissions",
              "For off-plan properties: verify the developer's track record across all completed projects. Request completion certificates and speak with previous buyers",
              "Review the PPJB (sale and purchase agreement) or lease deed in full before signing. Key clauses: payment milestones, penalties for late delivery, renewal terms (for leasehold), and dispute resolution",
              "Confirm the property's rental management structure: pooled income, individual rental, or management-only arrangements each carry different financial implications",
              "Verify the property has a valid PBG and Sertifikat Laik Fungsi (SLF, certificate of functional eligibility) before handover: occupancy without SLF is technically non-compliant",
            ].map(item => (
              <label class="flex items-start gap-3 p-3 bg-white rounded-lg border border-beige cursor-pointer hover:border-olive transition-colors group checklist-item">
                <div class="w-5 h-5 rounded border-2 border-olive shrink-0 mt-0.5 flex items-center justify-center transition-colors checkbox-box">
                  <svg class="w-3 h-3 text-white hidden check-icon" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <p class="text-sm text-brown group-[.checked]:line-through group-[.checked]:text-brown/40 transition-all">{item}</p>
              </label>
            ))}
          </div>
        </section>

        <!-- Tax and Finance -->
        <section id="tax-financial" class="guide-section mb-16">
          <h2>Tax and Financial Checklist</h2>

          <h3>Indonesian Tax Obligations</h3>
          <div class="space-y-3 mt-4">
            {[
              "PBB (Pajak Bumi dan Bangunan, Land and Building Tax): approximately 0.5% of assessed value per year, payable annually",
              "Rental income withholding tax: 10% final withholding tax on gross rental income for properties managed by a licensed operator",
