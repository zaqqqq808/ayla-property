  <script>
    // TOC active state
    const tocLinks = document.querySelectorAll('.toc-link');
    const sections = document.querySelectorAll('.guide-section');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          tocLinks.forEach(l => l.classList.remove('border-olive','text-olive'));
          const active = document.querySelector(`.toc-link[href="#${entry.target.id}"]`);
          active?.classList.add('border-olive','text-olive');
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(s => observer.observe(s));

    // Interactive checklist — tick and untick items, persist via localStorage
    const STORAGE_KEY = 'ayla-checklist-2026';
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');

    document.querySelectorAll('.checklist-item').forEach((label, i) => {
      const box = label.querySelector('.checkbox-box');
      const icon = label.querySelector('.check-icon');

      const setChecked = (checked) => {
        if (checked) {
          box.classList.add('bg-olive', 'border-olive');
          icon.classList.remove('hidden');
          label.classList.add('checked');
        } else {
          box.classList.remove('bg-olive', 'border-olive');
          icon.classList.add('hidden');
          label.classList.remove('checked');
        }
      };

      // Restore saved state
      if (saved[i]) setChecked(true);

      label.addEventListener('click', () => {
        const nowChecked = !label.classList.contains('checked');
        setChecked(nowChecked);
        saved[i] = nowChecked;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
      });
    });
  </script>
