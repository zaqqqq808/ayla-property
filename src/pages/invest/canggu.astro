---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_URL } from '@/config';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import StatsBar from '@/components/StatsBar.astro';
import WhyBali from '@/components/WhyBali.astro';
import FAQ from '@/components/FAQ.astro';
import HotListings from '@/components/HotListings.astro';
import AreaMarket from '@/components/AreaMarket.astro';
import { compareFor, compareRows } from '@/data/areas';
import ContactCTA from '@/components/ContactCTA.astro';
import AreaLinks from '@/components/AreaLinks.astro';
import Footer from '@/components/Footer.astro';
import StickyButton from '@/components/StickyButton.astro';

// ── Canggu-specific stats ─────────────────────────────────────────────────────
const cangguReasons = [
  {
    stat: '33%',
    statTo: [33],
    statSuffix: '%',
    statSep: '',
    title: 'Of Bali Transactions',
    description: "Canggu accounts for roughly a third of all villa transactions on the island, making it Bali's most liquid and in-demand property market.",
  },
  {
    stat: '15–20%',
    statTo: [15, 20],
    statSuffix: '%',
    statSep: '–',
    title: 'Rental Yields',
    description: 'Premium short-term rental demand from tourists and digital nomads pushes Canggu yields above the Bali average, consistently 15–20% gross.',
  },
  {
    stat: '85%+',
    statTo: [85],
    statSuffix: '%+',
    statSep: '',
    title: 'Average Occupancy',
    description: 'The digital nomad community fills gaps between peak tourist seasons, keeping Canggu villas occupied year-round at rates other areas cannot match.',
  },
  {
    stat: '3–5×',
    statTo: [3, 5],
    statSuffix: '×',
    statSep: '–',
    title: 'Capital Appreciation',
    description: "Prime Canggu land values have multiplied 3–5× over the past decade as the area transformed from a surf village into Bali's most sought-after address.",
  },
];

// ── Canggu-specific FAQs ──────────────────────────────────────────────────────
const cangguFaqs = [
  {
    q: 'What types of property are available in Canggu?',
    a: 'The Canggu market is dominated by private villas, ranging from 1–2 bedroom boutique villas to larger 4–5 bedroom luxury compounds. Off-plan developments are increasingly common and often offer the best yields and capital growth potential. We source across all types and match you to what fits your budget and goals.',
  },
  {
    q: 'What are typical villa prices in Canggu?',
    a: 'Entry-level Canggu villas start from around $150,000–$200,000 USD for a 1–2 bedroom on leasehold. Mid-range 3-bedroom villas in premium locations typically sit between $300,000–$500,000. Larger compounds and freehold titles command $600,000+. Off-plan pricing is often 15–20% below completed market value.',
  },
  {
    q: 'What rental yields can I expect from a Canggu villa?',
    a: 'Canggu consistently delivers 15–20% gross rental yields, with net returns of 10–14% after management fees and running costs. Short-term rental platforms (Airbnb, Booking.com) drive strong occupancy, and digital nomad demand keeps revenue flowing outside peak tourist months.',
  },
  {
    q: 'Is Canggu good for short-term rentals?',
    a: "Canggu is one of Bali's strongest short-term rental markets. It attracts digital nomads year-round, surfers in the dry season, and mainstream tourists throughout. This diversity of demand means you're not reliant on a single visitor type, which stabilises occupancy and reduces seasonal dips.",
  },
  {
    q: 'How does Canggu compare to Uluwatu or Seminyak for investment?',
    a: "Canggu leads on transaction volume and liquidity, so it's easier to buy and sell here than anywhere else in Bali. Uluwatu offers strong yields with a more upscale, cliff-top profile. Seminyak is more established but has less room for capital growth. Canggu tends to offer the best balance of yield, growth, and exit flexibility.",
  },
  {
    q: 'Is Canggu becoming oversupplied?',
    a: "It's a fair question. New supply is entering the market, but demand has grown at a faster rate. The digital nomad population in Canggu has increased year-on-year since 2021, and Bali's tourism numbers continue to break records. Well-located, well-managed villas are not experiencing softening. Location and quality selection matters more than ever, which is exactly where we add value.",
  },
];

// ── Canggu market data ────────────────────────────────────────────────────────
const areaTiers = [
  { label: "Entry villa", price: "$150K–$200K", note: "1–2 bed on leasehold, usually a short ride from the beach." },
  { label: "Mid-range", price: "$300K–$500K", note: "3 bed in a premium location with a private pool." },
  { label: "Large compounds", price: "$600K+", note: "4–5 bed estates on bigger plots." },
  { label: "Off-plan at launch", price: "15–20% less", note: "Below completed value, from developers with finished projects to inspect." },
];

const compareAreas = compareFor('canggu', ["pererenan", "seseh", "uluwatu"]);

const areaChecks = [
  {
    title: "How many villas are on your lane",
    body: "New supply keeps arriving in Canggu. Count the villas within a few hundred metres on Airbnb, check how booked they are, and price your own nightly rate against them, not against the developer’s brochure.",
  },
  {
    title: "The zoning, not just the address",
    body: "Canggu still has green-zone pockets between the villas. Ask for the zoning on the official spatial plan and make sure the PBG building permit matches a tourist rental.",
  },
  {
    title: "The drive at 5pm",
    body: "Canggu traffic is real. Time the drive from the villa to the beach and the main cafe strips at rush hour. Guests mention it in reviews, and reviews set your rate.",
  },
  {
    title: "What is being built next door",
    body: "A rice field view in Canggu can turn into a construction site within a year. Ask what the neighbouring plots are zoned for before you pay for the view.",
  },
  {
    title: "The rental licence",
    body: "Renting to holiday guests needs the right business licence, usually through a PT PMA or a licensed operator. Our <a href=\"/can-foreigners-buy-property-in-bali/\">ownership checker</a> shows which structure fits you.",
  },
  {
    title: "The lease you are actually buying",
    body: "Check the years remaining, not the years advertised, and get the extension terms and price in writing before you pay a deposit.",
  },
];

// ── Schema ────────────────────────────────────────────────────────────────────

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",            "item": `${SITE_URL}/` },
    { "@type": "ListItem", "position": 2, "name": "Canggu Villas for Sale", "item": `${SITE_URL}/invest/canggu/` },
  ]
});
---
<BaseLayout
  title="Canggu Villas for Sale: 2026 Prices, Yields and Listings | Ayla Property"
  description="What a villa in Canggu, Bali costs in 2026: from about $150K leasehold, 15–20% gross yields, how Canggu compares with Pererenan and Uluwatu, and what to check before you buy."
  ogType="website"
  ogImage="/og-canggu.jpg"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hero-villa-landscape.webp" fetchpriority="high" />
    <Fragment set:html={`<script type="application/ld+json">${breadcrumbSchema}</script>`} />
  </Fragment>

  <Header />
  <main>
    <Hero
      eyebrow="Canggu, Bali: villas and land"
      headlineHtml="Canggu Villas<br />for Sale"
      subline="What a villa here costs, what it earns, and the two Canggu listings we would buy this month."
      ctaText="Book a Free Investment Call"
    />

    <StatsBar />

    <!-- Canggu area intro -->
    <section class="bg-white py-16 px-6 lg:px-12">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-gold-dark uppercase tracking-widest text-sm font-semibold mb-4">Why Canggu</p>
        <p class="text-brown/80 text-lg leading-relaxed">
          Once a quiet surf village on Bali's southwest coast, Canggu has become the island's most
          dynamic investment hub. A thriving digital nomad scene, world-class surf breaks, and a
          dense cluster of restaurants, co-working spaces and beach clubs drive year-round occupancy
          that few other Bali areas can match. Villa prices remain accessible compared to Western
          markets, while yields consistently outperform them.
        </p>
        <p class="text-brown/70 text-base leading-relaxed mt-4">
          Canggu accounts for roughly 33% of all Bali villa transactions, making it the island's
          most liquid market. That liquidity matters. It means a clear exit path when you're ready
          to sell, and strong comparable data when negotiating your purchase price.
        </p>
      </div>
    </section>

    <HotListings
      areas={["Canggu", "Tibubeneng, Canggu"]}
      showClose={false}
      heading={"Two Canggu villas made our top six this month.<br /><span class=\"grad-text\">Here they are.</span>"}
      sub="Ask about either and we will send the full sales pack, the floor plans and our own numbers on the returns."
    />

    <AreaMarket
      area="Canggu"
      tiers={areaTiers}
      grossYield="15–20%"
      netYield="10–14%"
      compareRows={compareRows}
      compareAreas={compareAreas}
      checks={areaChecks}
    />

    <WhyBali
      eyebrow="The Canggu Opportunity"
      titleHtml="Why Investors<br />Choose Canggu"
      subtitle="Canggu delivers Bali's strongest combination of rental yield, occupancy, and capital growth, backed by the island's highest-demand rental market."
      ctaText="Find Out If Canggu Is Right For You"
      reasons={cangguReasons}
    />



    <FAQ
      eyebrow="Canggu Property FAQ"
      title="Canggu Questions Answered"
      faqs={cangguFaqs}
    />

    <AreaLinks
      links={[
        { href: '/invest/pererenan/', label: 'Pererenan Property Investment', note: "Canggu's quieter neighbour, 12–16% yields" },
        { href: '/invest/seseh/', label: 'Seseh Villa Investment', note: 'Premium boutique market just up the coast' },
        { href: '/invest/kedungu/', label: 'Kedungu Property Investment', note: 'The next Canggu — early-mover pricing' },
        { href: '/bali-roi-calculator/', label: 'Bali ROI Calculator', note: 'Model your Canggu villa returns' },
        { href: '/journal/best-areas-invest-bali-2026/', label: 'Best Areas to Invest in Bali 2026', note: 'Where our clients are buying now' },
        { href: '/guides/foreigners-buying-property-bali/', label: 'How to Buy Property in Bali', note: 'The legal process step by step' },
      ]}
    />

    <ContactCTA />
  </main>
  <Footer />
  <StickyButton />
</BaseLayout>
