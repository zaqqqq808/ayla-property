---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_URL, CALENDLY_URL } from '@/config';
import Header from '@/components/Header.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import Footer from '@/components/Footer.astro';
import StickyButton from '@/components/StickyButton.astro';

const faqs = [
  {
    "q": "Can foreigners buy property in Bali?",
    "a": "Yes. Foreign nationals can hold property in Bali through several legal structures: Hak Sewa leasehold, which requires only a passport, Hak Pakai right of use, which requires a stay permit, HMSRS strata title on apartments, and Hak Guna Bangunan held through a PT PMA company. What no foreigner can hold is Hak Milik freehold, which Article 21 of the Basic Agrarian Law 1960 reserves for Indonesian citizens."
  },
  {
    "q": "Can foreigners own land in Bali?",
    "a": "Not as freehold. Hak Milik, the absolute freehold title, is restricted to Indonesian citizens permanently. Foreigners can lease land under Hak Sewa for terms of 25 to 30 years with extensions commonly taking the total to 70 or 80 years, or hold Hak Guna Bangunan through a PT PMA company for up to 80 years."
  },
  {
    "q": "Can you buy property in Bali on a tourist visa?",
    "a": "You can sign a Hak Sewa leasehold on a tourist visa or visa on arrival. It is a notarised contract in your own name, fully recognised under Indonesian law, and it does not lapse if your visa expires. You cannot register Hak Pakai or hold strata title in your own name without a stay permit such as a KITAS, KITAP, Second Home Visa or Golden Visa."
  },
  {
    "q": "What is the difference between Hak Pakai and Hak Sewa?",
    "a": "Hak Sewa is a lease contract. It needs only a passport, has no minimum property value, and survives your visa lapsing. Hak Pakai is a registered land title in your own name at the BPN land office, running up to 80 years in total, but it requires a valid stay permit, carries a minimum property value of IDR 5 billion for a landed house in Bali, and is intended for personal residence rather than rental business."
  },
  {
    "q": "Do I need a KITAS to buy property in Bali?",
    "a": "Only for certain structures. Leasehold requires no visa at all. Hak Pakai and strata title both require a valid stay permit, which can be a KITAS, a KITAP, a Second Home Visa or a Golden Visa. If you plan to run a rental business you will need a PT PMA, which in turn can sponsor an investor KITAS for you as a shareholder."
  },
  {
    "q": "Can foreigners buy an apartment in Bali?",
    "a": "Yes, and apartments are the most straightforward route to real ownership. With a valid stay permit a foreigner can hold HMSRS strata title on a unit in their own name, subject to a minimum value of around IDR 2 billion in Bali. You own the unit plus a share of the common areas. Without a stay permit you can still take a leasehold on an apartment unit using only your passport."
  },
  {
    "q": "What is the minimum property value for foreigners in Bali?",
    "a": "For Hak Pakai on a landed house in Bali the published minimum is IDR 5 billion, roughly USD 310,000. For an apartment unit under strata title it is around IDR 2 billion, roughly USD 124,000. Leasehold carries no minimum value threshold. These figures are periodically revised, so confirm the current position with a notary before you transact."
  },
  {
    "q": "Can I legally rent out my villa in Bali?",
    "a": "Renting out is a commercial activity and needs a licensed entity. For foreigners that means a PT PMA holding the correct KBLI classification, typically 55193 for villa operations. Running short stay rentals on a Hak Pakai residential title or an unlicensed lease is outside what those structures permit, and enforcement in Bali has tightened considerably."
  },
  {
    "q": "How long does a Bali leasehold last?",
    "a": "A typical Hak Sewa lease runs 25 to 30 years initially, with extension options that commonly take the total to 70 or 80 years. The critical detail is that extension terms and pricing should be fixed in writing in the original contract. Leaving the extension price to be negotiated in year 29 is the most common and most expensive mistake in Bali leasehold."
  },
  {
    "q": "Is nominee ownership legal in Bali?",
    "a": "No. A nominee arrangement, where an Indonesian holds freehold title on your behalf under a private side agreement, is void and unenforceable under Indonesian law. Indonesian courts have consistently ruled that the foreign party loses both the land and the money paid for it. There is no version of this structure that survives a legal challenge."
  },
  {
    "q": "Is Bali cheap to buy property?",
    "a": "Compared to Western markets, yes. The median entry price across the 511 listings we track is around USD 290,000, and the market realistically starts near USD 150,000 for a one bedroom in an emerging area. The same capital buys a fraction of the rental income in Sydney, London or Singapore, where gross yields sit between 2.8 and 3.6 percent against a Bali average of 10.6 percent."
  },
  {
    "q": "How much property does USD 100,000 buy in Bali?",
    "a": "At that level you are looking at a one bedroom apartment or a small leasehold villa in an emerging area such as Kedungu or the western Bukit, usually off plan rather than completed. Prime areas like Canggu and Uluwatu start considerably higher. Bear in mind a leasehold at this price point often has a shorter remaining term, so check the extension terms before comparing it against a higher priced listing."
  }
];

const toc = [
  {
    "id": "can-foreigners-buy-property-in-bali",
    "label": "Can foreigners buy property in Bali?"
  },
  {
    "id": "can-foreigners-own-land-in-bali",
    "label": "Can foreigners own land in Bali?"
  },
  {
    "id": "the-four-ways-a-foreigner-can-hold-bali-property",
    "label": "The four ways a foreigner can hold Bali property"
  },
  {
    "id": "what-visa-do-you-need-to-buy-property-in-bali",
    "label": "What visa do you need to buy property in Bali?"
  },
  {
    "id": "if-you-are-married-to-an-indonesian-citizen",
    "label": "If you are married to an Indonesian citizen"
  },
  {
    "id": "renting-your-bali-property-out-legally",
    "label": "Renting your Bali property out legally"
  },
  {
    "id": "nominee-arrangements-do-not",
    "label": "Nominee arrangements: do not"
  }
];

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
    { "@type": "ListItem", "position": 2, "name": "Can Foreigners Buy Property in Bali?", "item": `${SITE_URL}/can-foreigners-buy-property-in-bali/` },
  ]
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
});

const appSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Bali Property Ownership Checker",
  "url": `${SITE_URL}/can-foreigners-buy-property-in-bali/`,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires JavaScript",
  "description": "Free interactive tool. Answer four questions about what you want to buy, your citizenship, your visa and how you will use the property, and see exactly which Indonesian ownership structure applies to you.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "provider": { "@type": "Organization", "name": "Ayla Property", "url": SITE_URL }
});
---

<BaseLayout
  title="Can Foreigners Buy Property in Bali? Free Ownership Checker 2026"
  description="Yes, and a leasehold needs only a passport. Answer four questions in our free tool to see exactly which Bali ownership structure applies to you, the visa you need, and the minimum values involved."
  ogType="website"
  ogImage="/images/journal/can-you-buy-property-in-bali.jpg"
>
  <Fragment slot="head">
    <Fragment set:html={`<script type="application/ld+json">${breadcrumbSchema}</script>`} />
    <Fragment set:html={`<script type="application/ld+json">${appSchema}</script>`} />
    <Fragment set:html={`<script type="application/ld+json">${faqSchema}</script>`} />
  </Fragment>

  <Header />

  <main class="own">

    <section class="own-hero">
      <div class="own-wrap">
        <h1>Can Foreigners Buy<br /><span class="grad-text">Property in Bali?</span></h1>
        <p class="own-lede">
          Yes. What you cannot do is hold freehold land in your own name. A leasehold on a villa or land needs
          nothing more than a valid passport. Answer four questions below to see which structure applies to you.
        </p>
      </div>
    </section>

    <section class="own-tool">
      <div class="own-wrap">
<style is:global>
.own{background:#fff;overflow-x:hidden}
.own-wrap{max-width:900px;margin:0 auto;padding:0 24px}
.own-hero{padding:150px 0 34px;text-align:center}
.own-hero h1{font-family:var(--font-display);font-size:3.4rem;line-height:1.08;color:var(--text);
font-weight:600;margin:0 0 20px;letter-spacing:.01em}
.own-lede{font-size:1.12rem;line-height:1.68;color:var(--text-muted);max-width:660px;margin:0 auto}
.own-tool{padding:0 0 20px}
.own-content{padding:8px 0 40px}
.own-prose h2{font-family:var(--font-display);font-size:1.9rem;line-height:1.22;margin:52px 0 16px;
color:var(--text);scroll-margin-top:100px}
.own-prose h3{font-family:var(--font-display);font-size:1.3rem;line-height:1.3;margin:32px 0 12px;
color:var(--text);scroll-margin-top:100px}
.own-prose p{font-size:1rem;line-height:1.75;color:var(--text-muted);margin-bottom:16px}
.own-prose strong{color:var(--text);font-weight:600}
.own-prose ul,.own-prose ol{margin:0 0 18px;padding-left:22px;display:flex;flex-direction:column;gap:10px}
.own-prose li{font-size:1rem;line-height:1.7;color:var(--text-muted)}
.own-prose a{color:var(--teal);font-weight:600;text-decoration:none}
.own-prose a:hover{text-decoration:underline}
.own-prose em{color:var(--text-muted)}
.own-toc{background:var(--bg-base);border:1px solid var(--glass-border);border-radius:14px;
padding:22px 24px;margin:0 0 34px}
.own-toc-h{font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;
color:var(--accent);margin:0 0 12px}
.own-toc ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
.own-toc li{font-size:.95rem;line-height:1.5}
.own-toc a{color:var(--text-muted);text-decoration:none;font-weight:500}
.own-toc a:hover{color:var(--terra);text-decoration:underline}
.own-faq{border-top:1px solid rgba(122,92,52,.16);margin-top:10px}
.own-faq-item{border-bottom:1px solid rgba(122,92,52,.16)}
.own-faq-item summary{cursor:pointer;padding:18px 0;font-weight:600;font-size:1rem;color:var(--text);
list-style:none;display:flex;justify-content:space-between;gap:16px;align-items:center}
.own-faq-item summary::-webkit-details-marker{display:none}
.own-faq-item summary:after{content:"+";font-size:1.35rem;color:var(--accent);font-weight:400;flex-shrink:0;line-height:1}
.own-faq-item[open] summary:after{content:"\2013"}
.own-faq-item p{margin:0 0 20px;font-size:.95rem;line-height:1.72;color:var(--text-muted)}
.own-related{margin-top:40px;padding:26px 24px;background:var(--bg-base);
border:1px solid var(--glass-border);border-radius:14px}
.own-related-h{font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;
color:var(--accent);margin:0 0 14px}
.own-related ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:11px}
.own-related li{font-size:.95rem;line-height:1.6;color:var(--text-muted)}
.own-related a{color:var(--teal);font-weight:600;text-decoration:none}
.own-related a:hover{text-decoration:underline}
@media(max-width:860px){
.own-hero{padding:118px 0 26px}
.own-hero h1{font-size:2.5rem}
.own-lede{font-size:1rem}
.own-prose h2{font-size:1.55rem;margin:40px 0 12px}
.own-prose h3{font-size:1.18rem}
.own-prose p,.own-prose li{font-size:.95rem;line-height:1.68}
.own-toc{padding:18px 18px}
}
@media(max-width:560px){
.own-wrap{padding:0 16px}
.own-hero{padding:104px 0 20px}
.own-hero h1{font-size:2.05rem}
.own-prose h2{font-size:1.38rem}
}
</style>
<style is:global>
.bfc{--bfc-brown:#5C2E1F;--bfc-olive:#2A7A55;--bfc-gold:#C2A973;--bfc-cream:#F5EDE0;--bfc-ink:#3A2318;
width:100%;max-width:100%;margin:3rem 0;box-sizing:border-box;
font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
color:var(--bfc-ink);line-height:1.6;overflow-wrap:break-word;
-webkit-tap-highlight-color:rgba(42,122,85,.12)}
.bfc *{box-sizing:border-box;max-width:100%}
.bfc p,.bfc ul,.bfc li,.bfc h2,.bfc h3,.bfc h4{margin:0;padding:0;font-family:inherit;color:inherit}
.bfc ul{list-style:none}
.bfc button{-webkit-appearance:none;appearance:none}
.bfc-shell{background:linear-gradient(168deg,#FBF7F0 0%,#F5EDE0 100%);
border:1px solid rgba(194,169,115,.45);border-radius:20px;padding:34px 30px 30px;
box-shadow:0 24px 60px -28px rgba(92,46,31,.35)}
.bfc-top{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:22px}
.bfc-kicker{font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:var(--bfc-gold)}
.bfc-reset{background:none;border:1px solid rgba(92,46,31,.25);color:var(--bfc-brown);
font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;font-weight:600;padding:10px 16px;
border-radius:999px;cursor:pointer;transition:all .2s;font-family:inherit;min-height:40px}
.bfc-bar{height:4px;background:rgba(92,46,31,.12);border-radius:999px;overflow:hidden;margin-bottom:26px}
.bfc-bar-fill{height:100%;width:0%;border-radius:999px;
background:linear-gradient(90deg,var(--bfc-gold),var(--bfc-olive));transition:width .45s cubic-bezier(.4,0,.2,1)}
.bfc-trail{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:24px;min-height:26px}
.bfc-chip{display:inline-flex;align-items:center;gap:6px;background:rgba(42,122,85,.1);
border:1px solid rgba(42,122,85,.28);color:var(--bfc-olive);font-size:.72rem;font-weight:600;
padding:5px 11px;border-radius:999px;animation:bfcPop .3s ease}
@keyframes bfcPop{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
.bfc-q{font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;
color:rgba(92,46,31,.5);margin-bottom:8px}
.bfc-h{font-family:Marcellus,"Cormorant Garamond",Georgia,serif;font-size:1.85rem;line-height:1.22;
color:var(--bfc-brown);margin-bottom:24px;font-weight:400}
.bfc-opts{display:grid;gap:12px;grid-template-columns:1fr}
@media(min-width:560px){.bfc-opts.bfc-2{grid-template-columns:repeat(2,1fr)}}
@media(min-width:720px){.bfc-opts.bfc-3{grid-template-columns:repeat(3,1fr)}}
.bfc-opt{text-align:left;background:#fff;border:1.5px solid rgba(92,46,31,.14);border-radius:14px;
padding:17px 17px 16px;cursor:pointer;transition:all .22s cubic-bezier(.4,0,.2,1);
font-family:inherit;color:inherit;display:flex;flex-direction:column;gap:5px;width:100%;min-height:56px}
.bfc-opt:active{transform:scale(.985);border-color:var(--bfc-olive);background:#FCFBF8}
.bfc-opt-t{font-weight:700;font-size:1rem;color:var(--bfc-brown);line-height:1.3}
.bfc-opt-d{font-size:.83rem;color:rgba(58,35,24,.68);line-height:1.5}
.bfc-back{margin-top:22px;display:inline-flex;align-items:center;gap:8px;background:#fff;
border:1.5px solid rgba(92,46,31,.22);color:var(--bfc-brown);font-size:.82rem;font-weight:700;
cursor:pointer;padding:11px 20px;border-radius:999px;font-family:inherit;min-height:44px;
transition:all .2s cubic-bezier(.4,0,.2,1)}
.bfc-back:before{content:"\2190";font-size:1.02rem;line-height:1;transition:transform .2s}
.bfc-back:active{transform:translateY(1px);background:var(--bfc-cream)}
.bfc-res-badge{display:inline-block;background:var(--bfc-olive);color:#fff;font-size:.66rem;
letter-spacing:.14em;text-transform:uppercase;font-weight:700;padding:6px 13px;border-radius:999px;margin-bottom:14px}
.bfc-res-badge.warn{background:#B4502A}
.bfc-res-h{font-family:Marcellus,"Cormorant Garamond",Georgia,serif;font-size:2rem;line-height:1.17;
color:var(--bfc-brown);margin-bottom:12px;font-weight:400}
.bfc-res-sum{font-size:1.02rem;color:rgba(58,35,24,.85);margin-bottom:24px;line-height:1.65}
.bfc-cards{display:grid;gap:14px;margin-bottom:24px;grid-template-columns:1fr}
@media(min-width:700px){.bfc-cards{grid-template-columns:repeat(2,1fr)}}
.bfc-card{background:#fff;border:1px solid rgba(92,46,31,.12);border-radius:14px;padding:18px 18px 16px}
.bfc-card-t{font-size:.68rem;letter-spacing:.13em;text-transform:uppercase;font-weight:700;
color:var(--bfc-gold);margin-bottom:11px}
.bfc-card ul{display:flex;flex-direction:column;gap:9px}
.bfc-card li{font-size:.88rem;line-height:1.55;padding-left:17px;position:relative;color:rgba(58,35,24,.85)}
.bfc-card li:before{content:"";position:absolute;left:0;top:8px;width:6px;height:6px;
border-radius:50%;background:var(--bfc-olive)}
.bfc-card.warn{background:#FDF6F2;border-color:rgba(180,80,42,.3)}
.bfc-card.warn .bfc-card-t{color:#B4502A}
.bfc-card.warn li:before{background:#B4502A}
.bfc-cta{background:linear-gradient(135deg,var(--bfc-brown),#4A2419);border-radius:16px;
padding:26px 22px;text-align:center;color:#F5EDE0}
.bfc-cta-h{font-family:Marcellus,"Cormorant Garamond",Georgia,serif;font-size:1.35rem;line-height:1.3;
margin-bottom:8px;color:#F5EDE0;font-weight:400}
.bfc-cta-p{font-size:.9rem;opacity:.85;margin-bottom:18px;max-width:440px;margin-left:auto;margin-right:auto}
.bfc-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.bfc-btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 22px;
border-radius:999px;font-size:.86rem;font-weight:700;text-decoration:none;
transition:transform .2s;font-family:inherit;min-height:46px}
.bfc-btn.gold{background:linear-gradient(135deg,#C2A973,#A8873F);color:#FFF8EC}
.bfc-btn.wa{background:#25D366;color:#fff}
.bfc-btn:active{transform:translateY(1px)}
.bfc-ref{margin-top:26px;background:#fff;border:1px solid rgba(92,46,31,.13);border-left:4px solid var(--bfc-gold);
border-radius:14px;padding:26px 26px 24px}
.bfc-ref-k{font-size:.66rem;letter-spacing:.15em;text-transform:uppercase;font-weight:700;
color:var(--bfc-gold);margin-bottom:9px}
.bfc-ref-h{font-family:Marcellus,"Cormorant Garamond",Georgia,serif;font-size:1.5rem;line-height:1.28;
color:var(--bfc-brown);margin-bottom:16px;font-weight:400}
.bfc-ref-body{font-size:.93rem;line-height:1.72;color:rgba(58,35,24,.86)}
.bfc-ref-body p{margin-bottom:14px}
.bfc-ref-body p:last-child{margin-bottom:0}
.bfc-ref-body strong{color:var(--bfc-brown);font-weight:700}
.bfc-defs{display:flex;flex-direction:column;gap:13px;margin:16px 0}
.bfc-def{padding-left:15px;border-left:2px solid rgba(194,169,115,.5)}
.bfc-def-t{font-weight:700;color:var(--bfc-brown);font-size:.9rem;margin-bottom:3px}
.bfc-def-d{font-size:.88rem;color:rgba(58,35,24,.78);line-height:1.6}
.bfc-note{background:var(--bfc-cream);border-radius:10px;padding:14px 16px;font-size:.86rem;
line-height:1.6;color:rgba(58,35,24,.85);margin-top:16px}
.bfc-fade{animation:bfcFade .35s ease}
@keyframes bfcFade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@media(hover:hover) and (pointer:fine){
.bfc-reset:hover{background:var(--bfc-brown);color:#FBF7F0;border-color:var(--bfc-brown)}
.bfc-opt:hover{border-color:var(--bfc-olive);transform:translateY(-3px);
box-shadow:0 14px 32px -14px rgba(42,122,85,.45)}
.bfc-back:hover{background:var(--bfc-brown);color:#FBF7F0;border-color:var(--bfc-brown);
box-shadow:0 9px 22px -9px rgba(92,46,31,.55)}
.bfc-back:hover:before{transform:translateX(-3px)}
.bfc-btn:hover{transform:translateY(-2px)}}
@media(max-width:640px){
.bfc{margin:2.25rem 0}
.bfc-shell{padding:22px 16px 20px;border-radius:16px}
.bfc-top{margin-bottom:18px}
.bfc-bar{margin-bottom:20px}
.bfc-trail{gap:6px;margin-bottom:18px}
.bfc-chip{font-size:.68rem;padding:5px 10px}
.bfc-h{font-size:1.42rem;margin-bottom:18px}
.bfc-opt{padding:15px 15px 14px;border-radius:12px}
.bfc-opt-t{font-size:.95rem}
.bfc-opt-d{font-size:.8rem;line-height:1.45}
.bfc-res-h{font-size:1.55rem}
.bfc-res-sum{font-size:.95rem;margin-bottom:20px}
.bfc-card{padding:16px 15px 14px}
.bfc-card li{font-size:.85rem}
.bfc-cta{padding:22px 17px}
.bfc-cta-h{font-size:1.2rem}
.bfc-cta-p{font-size:.86rem}
.bfc-btns{flex-direction:column;gap:9px}
.bfc-btn{width:100%}
.bfc-ref{padding:20px 17px 18px;margin-top:20px;border-left-width:3px}
.bfc-ref-h{font-size:1.22rem}
.bfc-ref-body{font-size:.89rem;line-height:1.68}
.bfc-def{padding-left:13px}
.bfc-note{padding:13px 14px;font-size:.83rem}}
@media(max-width:380px){
.bfc-shell{padding:18px 13px 17px}
.bfc-h{font-size:1.3rem}
.bfc-res-h{font-size:1.38rem}
.bfc-kicker{font-size:.63rem}}
@media(prefers-reduced-motion:reduce){
.bfc *,.bfc *:before{animation:none!important;transition:none!important}
.bfc-opt:hover,.bfc-btn:hover,.bfc-back:hover{transform:none!important}}
</style>

<div class="bfc not-prose" id="bfc">
<div class="bfc-shell">
<div class="bfc-top">
<span class="bfc-kicker">Bali Ownership Pathfinder</span>
<button type="button" class="bfc-reset" id="bfcReset">Start again</button>
