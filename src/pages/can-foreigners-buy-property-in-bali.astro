["Setup requirements 2026",["Minimum paid up capital IDR 2.5 billion, roughly USD 155,000, cut from IDR 10 billion by BKPM Regulation 5 of 2025 on 2 October 2025","The full amount must sit in the company bank account at incorporation and be declared through the OSS system","A 12 month lock up applies, that capital cannot leave the account for a year except for asset purchase, construction or genuine operating costs","Separate minimum investment value of IDR 10 billion, around USD 620,000, excluding land and buildings, and this applies per business line and per project location","Minimum two shareholders","KBLI 55193 for villa operations in the articles of association","Registration with BKPM and an Indonesian registered address"]],
["What it unlocks",["An investor KITAS, E28A, for you as a shareholder","Legal short stay rental operations","Ability to employ staff and open corporate banking","A credible structure for financing and resale"]],
["The ongoing obligations",["Monthly and quarterly BKPM investment reporting","Corporate tax filing and annual financial statements","Tax on rental income, plus 11 percent VAT where applicable","Real annual running costs, budget for them from the start"]]]},
landlease:{badge:"Leasehold, passport only",h:"Lease the land, build what you want on it",sum:"Foreign nationals cannot hold land freehold under any circumstances. What you can do, on nothing more than a passport, is take a long lease on the plot and develop it. This is how a large share of foreign built villas in Bali actually happen.",
cards:[["The structure",["Hak Sewa lease on the plot, 25 to 30 years typical","Extension options can take the total to 70 or 80 years","Signed in your own name with a notary, no visa needed","Building you construct is yours for the lease term"]],
["Before you sign anything",["Zoning check, the ITR, confirms you can legally build your use case","Green zone land cannot be developed, this catches people out","Soil, access and drainage surveys before money moves","Extension pricing fixed now, not negotiated in year twenty nine","Who owns the building at lease end, spell it out in the contract"]],
["Permits you will need",["PBG building approval, formerly the IMB","SLF certificate of functional worthiness on completion","Environmental clearance depending on scale","A licensed operator structure if you will rent it out"]],
["The alternative worth pricing",["A PT PMA can hold HGB on land, a stronger position","Eighty year horizon and no dependence on a private landlord","Higher setup cost and ongoing compliance","Compare both properly before committing capital"]]]}};
var st={},path=[];
var stage=document.getElementById("bfcStage"),trail=document.getElementById("bfcTrail"),
bar=document.getElementById("bfcBar"),ref=document.getElementById("bfcRef");
function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}
function nextKey(){
if(!st.goal)return "goal";
if(!st.citizen)return "citizen";
if(st.citizen==="wni")return null;
if(st.citizen==="mixed"){if(!st.prenup)return "prenup";return null;}
if(!st.visa)return "visa";
if(!st.use)return "use";
return null;}
function resolve(){
if(st.citizen==="wni")return OUT.wni;
if(st.citizen==="mixed")return st.prenup==="yes"?OUT.mixedyes:OUT.mixedno;
var rent=(st.use==="rent"||st.use==="both");
var permit=(st.visa==="kitas"||st.visa==="investor");
if(st.goal==="land"){return rent?OUT.ptpma:OUT.landlease;}
if(rent)return st.visa==="tourist"?OUT.leaserent:OUT.ptpma;
if(st.goal==="apartment")return permit?OUT.strata:OUT.lease;
return permit?OUT.hakpakai:OUT.lease;}
function steps(){
if(st.citizen==="wni")return 2;
if(st.citizen==="mixed")return 3;
return 4;}
function drawTrail(){
trail.innerHTML=path.map(function(p){return '<span class="bfc-chip">'+esc(LBL[st[p]])+'</span>';}).join("");}
function drawBar(){
var tot=steps(),done=path.length;
bar.style.width=Math.min(100,Math.round(done/tot*100))+"%";}
function drawRef(k){
var r=REF[k];if(!r)return;
ref.className="bfc-ref bfc-fade";
ref.innerHTML='<div class="bfc-ref-k">'+r.k+'</div><h3 class="bfc-ref-h">'+r.h+'</h3><div class="bfc-ref-body">'+r.b+'</div>';
setTimeout(function(){ref.className="bfc-ref";},400);}
function drawRefResult(o){
ref.className="bfc-ref bfc-fade";
var h='<div class="bfc-ref-k">Your full briefing</div><h3 class="bfc-ref-h">'+esc(o.h)+'</h3><div class="bfc-ref-body"><p>'+esc(o.sum)+'</p>';
h+='<div class="bfc-defs">';
o.cards.forEach(function(c){
h+='<div class="bfc-def"><div class="bfc-def-t">'+esc(c[0])+'</div><div class="bfc-def-d">'+c[1].map(esc).join(". ")+'.</div></div>';});
h+='</div><div class="bfc-note"><strong>One caveat worth reading.</strong> Indonesian property regulation is revised more often than most jurisdictions and thresholds in particular get adjusted. Everything here reflects the position as at July 2026. Treat it as an accurate map of the terrain, not as a substitute for a notary who confirms the current rules on the day you transact.</div></div>';
ref.innerHTML=h;
setTimeout(function(){ref.className="bfc-ref";},400);}
function renderQ(k){
var d=Q[k];
var h='<div class="bfc-fade"><div class="bfc-q">'+d.q+'</div><h3 class="bfc-h">'+d.h+'</h3><div class="bfc-opts bfc-'+d.cols+'">';
d.opts.forEach(function(o){
h+='<button type="button" class="bfc-opt" data-k="'+k+'" data-v="'+o.v+'"><span class="bfc-opt-t">'+esc(o.t)+'</span><span class="bfc-opt-d">'+esc(o.d)+'</span></button>';});
h+='</div>';
if(path.length)h+='<button type="button" class="bfc-back" id="bfcBack">Back one step</button>';
h+='</div>';
stage.innerHTML=h;
drawRef(k);}
function renderResult(){
var o=resolve();
var h='<div class="bfc-fade"><span class="bfc-res-badge'+(o.warn?" warn":"")+'">'+esc(o.badge)+'</span><h3 class="bfc-res-h">'+esc(o.h)+'</h3><p class="bfc-res-sum">'+esc(o.sum)+'</p><div class="bfc-cards">';
o.cards.forEach(function(c,i){
h+='<div class="bfc-card'+(o.warn&&i===1?" warn":"")+'"><div class="bfc-card-t">'+esc(c[0])+'</div><ul>';
c[1].forEach(function(li){h+='<li>'+esc(li)+'</li>';});
h+='</ul></div>';});
h+='</div><div class="bfc-cta"><div class="bfc-cta-h">Want this checked against a real property?</div><p class="bfc-cta-p">We are the only fully agnostic agency in Bali. We hold data on almost every developer on the island and we represent none of them, so the recommendation you get is the one that suits you.</p><div class="bfc-btns"><a class="bfc-btn gold" href="'+CAL+'">Book a free call</a><a class="bfc-btn wa" href="'+WA+'" target="_blank" rel="noopener noreferrer">Ask on WhatsApp</a></div></div>';
h+='<button type="button" class="bfc-back" id="bfcBack">Back one step</button></div>';
stage.innerHTML=h;
drawRefResult(o);}
function render(){
drawTrail();drawBar();
var k=nextKey();
if(k)renderQ(k);else renderResult();}
stage.addEventListener("click",function(e){
var b=e.target.closest(".bfc-opt");
if(b){var k=b.getAttribute("data-k");st[k]=b.getAttribute("data-v");
if(path.indexOf(k)===-1)path.push(k);render();
var top=document.getElementById("bfc").getBoundingClientRect().top+window.scrollY-90;
if(window.scrollY>top)window.scrollTo({top:top,behavior:"smooth"});return;}
if(e.target.id==="bfcBack"){var last=path.pop();if(last){delete st[last];
if(last==="citizen"){delete st.prenup;delete st.visa;delete st.use;
path=path.filter(function(p){return p!=="prenup"&&p!=="visa"&&p!=="use";});}}
render();}});
document.getElementById("bfcReset").addEventListener("click",function(){
st={};path=[];render();
var top=document.getElementById("bfc").getBoundingClientRect().top+window.scrollY-90;
window.scrollTo({top:top,behavior:"smooth"});});
render();
})();
</script>
</BaseLayout>
