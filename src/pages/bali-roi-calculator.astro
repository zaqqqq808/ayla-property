---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_URL, CALENDLY_URL } from '@/config';
import Header from '@/components/Header.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import Footer from '@/components/Footer.astro';
import StickyButton from '@/components/StickyButton.astro';

// ── Default scenario, computed at build time so the numbers ship in the HTML ──
const D = { price: 290000, nightly: 250, occ: 0.72, mgmt: 0.20, maint: 0.04, tax: 0.10 };
const dGross = D.nightly * 365 * D.occ;
const dMgmt = dGross * D.mgmt;
const dMaint = D.price * D.maint;
const dTax = dGross * D.tax;
const dNet = dGross - dMgmt - dMaint - dTax;
const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const def = {
  grossYield: (dGross / D.price * 100).toFixed(1) + '%',
  netYield: (dNet / D.price * 100).toFixed(1) + '%',
  grossIncome: usd(dGross),
  mgmtFees: '\u2212' + usd(dMgmt),
  maintCost: '\u2212' + usd(dMaint),
  taxCost: '\u2212' + usd(dTax),
  netIncome: usd(dNet),
  payback: (D.price / dNet).toFixed(1),
  fiveYear: usd(dNet * 5),
};

const areaYields = [
  { area: 'Canggu',     entry: '$380,000', gross: '14.8%', note: 'Deepest short-term rental demand, year-round occupancy' },
  { area: 'Pererenan',  entry: '$320,000', gross: '13.9%', note: 'Canggu overflow, lower entry, similar guest profile' },
  { area: 'Seminyak',   entry: '$420,000', gross: '13.1%', note: 'Mature luxury market, premium nightly rates' },
  { area: 'Uluwatu',    entry: '$395,000', gross: '12.4%', note: 'Clifftop premium, strong capital preservation' },
  { area: 'Sanur',      entry: '$265,000', gross: '11.6%', note: 'Family and long-stay market, steadier occupancy' },
  { area: 'Kedungu',    entry: '$240,000', gross: '11.2%', note: 'Early pricing, 12 to 18 month rental ramp-up' },
];

const benchmarks = [
  { market: 'Bali (market average)', yieldPct: '10.6%', note: 'Across the 511 listings we track' },
  { market: 'Dubai residential',     yieldPct: '6.5%',  note: 'Gross residential yield 2026' },
  { market: 'Lisbon residential',    yieldPct: '4.5%',  note: 'Gross residential yield 2026' },
  { market: 'London residential',    yieldPct: '3.6%',  note: 'Gross residential yield 2026' },
  { market: 'Sydney residential',    yieldPct: '3.2%',  note: 'Gross residential yield 2026' },
  { market: 'Singapore residential', yieldPct: '2.8%',  note: 'Gross residential yield 2026' },
];

const calcFaqs = [
  {
    q: 'What is a good rental yield in Bali?',
    a: 'Gross yields average 10.6 percent across the 511 listings we track. Anything above 12 percent gross is a strong result, and well positioned villas in Canggu and Pererenan run 14 to 15 percent. Net of management, maintenance and withholding tax, expect roughly two thirds of the gross figure to land in your account.',
  },
  {
    q: 'How do you calculate ROI on a Bali villa?',
    a: 'Gross yield is annual rental income divided by purchase price. Annual rental income is your nightly rate multiplied by 365 and then by your occupancy rate. Net yield subtracts management fees, annual maintenance and Indonesian withholding tax before dividing by purchase price. Payback period is purchase price divided by net annual income.',
  },
  {
    q: 'What is the average ROI on a Bali villa?',
    a: 'On the market median of roughly USD 290,000, a villa running at a 250 dollar nightly rate and 72 percent occupancy produces about USD 65,700 gross and USD 34,390 net per year. That is a 22.7 percent gross and 11.9 percent net yield, with capital paid back in roughly 8.4 years. Weaker occupancy or a lower nightly rate moves those figures down quickly, which is why the calculator lets you change both.',
  },
  {
    q: 'What occupancy rate should I assume for a Bali villa?',
    a: 'The market average across managed villas is around 72 percent. Use 55 percent if you want a conservative case or if the property sits in an emerging area without established rental infrastructure. Top performing villas in Canggu with a strong operator reach 85 to 90 percent, but you should not underwrite a purchase on that assumption.',
  },
  {
    q: 'What are the ongoing costs of owning a villa in Bali?',
    a: 'Budget 15 to 25 percent of gross rental income for professional management, 3 to 5 percent of property value per year for maintenance because the tropical climate is hard on buildings, and 10 percent withholding tax on rental income for foreign individual owners. A PT PMA structure is taxed differently and you should confirm the current position with an advisor.',
  },
  {
    q: 'Is rental income in Bali taxed?',
    a: 'Yes. Foreign individual owners face a 10 percent withholding tax on rental income. If you hold the property through a PT PMA company, the company is assessed under corporate tax rules instead. Separately, spending 183 days or more in Indonesia in a twelve month period makes you an Indonesian tax resident, assessed on worldwide income.',
  },
];

const softwareSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Bali Property ROI & Rental Yield Calculator",
  "url": `${SITE_URL}/bali-roi-calculator/`,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires JavaScript",
  "description": "Free calculator for Bali villa investments. Enter purchase price, nightly rate, occupancy, management fee, maintenance and withholding tax to see gross yield, net yield, annual income and payback period.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "provider": { "@type": "Organization", "name": "Ayla Property", "url": SITE_URL }
});

const calcFaqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": calcFaqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
    { "@type": "ListItem", "position": 2, "name": "Bali Property ROI Calculator", "item": `${SITE_URL}/bali-roi-calculator/` },
  ]
});
---

<BaseLayout
  title="Bali Rental Yield & ROI Calculator 2026 | Ayla Property"
  description="Free Bali rental yield calculator. See gross yield, net yield, annual income and payback period on any villa. Bali averages 10.6% gross against 3.2% in Sydney and 2.8% in Singapore."
  ogType="website"
  ogImage="/og-image.jpg"
>
  <Fragment slot="head">
    <Fragment set:html={`<script type="application/ld+json">${breadcrumbSchema}</script>`} />
    <Fragment set:html={`<script type="application/ld+json">${softwareSchema}</script>`} />
    <Fragment set:html={`<script type="application/ld+json">${calcFaqSchema}</script>`} />
  </Fragment>

  <Header />

  <main>

  <section class="calc-hero">
    <div class="container">
      <h1>Bali Property<br /><span class="grad-text">ROI Calculator</span></h1>
      <p>Enter your numbers to see gross yield, net yield, annual income, and how long until your investment pays for itself.</p>
    </div>
  </section>

  <section class="container calc-layout">

    <!-- ===== INPUTS ===== -->
    <div class="panel glass">
      <h2>Your Investment Details</h2>

      <div class="field">
        <label for="price">Purchase Price (USD)</label>
        <div class="input-wrap">
          <span class="prefix" aria-hidden="true">$</span>
          <input type="number" id="price" value="290000" min="10000" step="5000" inputmode="numeric" />
        </div>
        <p class="hint">2026 market median is $290,000 USD</p>
      </div>

      <div class="field">
        <label for="nightly">Average Nightly Rate (USD)</label>
        <div class="input-wrap">
          <span class="prefix" aria-hidden="true">$</span>
          <input type="number" id="nightly" value="250" min="20" step="10" inputmode="numeric" />
        </div>
        <p class="hint">Canggu villas average $200 to $350 per night</p>
      </div>

      <div class="field">
        <label for="occupancy">Occupancy Rate: <span class="slider-val" id="occVal">72%</span></label>
        <input type="range" id="occupancy" min="20" max="100" value="72" step="1" aria-describedby="occHint" />
        <div class="range-row" id="occHint"><span>20%</span><span>Conservative 55% · Market avg 72% · Top 90%</span><span>100%</span></div>
      </div>

      <div class="field">
        <label for="mgmt">Management Fee: <span class="slider-val" id="mgmtVal">20%</span></label>
        <input type="range" id="mgmt" min="10" max="35" value="20" step="1" aria-describedby="mgmtHint" />
        <div class="range-row" id="mgmtHint"><span>10%</span><span>Typical 15–25%</span><span>35%</span></div>
      </div>

      <div class="field">
        <label for="maint">Annual Maintenance: <span class="slider-val" id="maintVal">4%</span> of property value</label>
        <input type="range" id="maint" min="1" max="10" value="4" step="0.5" aria-describedby="maintHint" />
        <div class="range-row" id="maintHint"><span>1%</span><span>Tropical climate typical 3–5%</span><span>10%</span></div>
      </div>

      <div class="field">
        <label id="taxLabel">Indonesian Withholding Tax on Rental</label>
        <div class="radio-group" role="radiogroup" aria-labelledby="taxLabel">
          <label class="radio-card selected">
            <input type="radio" name="tax" value="10" checked />
            10% (standard for foreign owners)
          </label>
          <label class="radio-card">
            <input type="radio" name="tax" value="0" />
            0% (PT PMA corporate — check with advisor)
          </label>
        </div>
      </div>
    </div>

    <!-- ===== RESULTS ===== -->
    <div class="results">
      <div class="yield-grid">
        <div class="yield-card glass">
          <div class="lbl">Gross Yield</div>
          <div class="val" id="grossYield">{def.grossYield}</div>
          <div class="sub">Before costs</div>
        </div>
        <div class="yield-card glass net">
          <div class="lbl">Net Yield</div>
          <div class="val" id="netYield">{def.netYield}</div>
          <div class="sub">After all costs</div>
        </div>
      </div>

      <div class="breakdown glass">
        <h3>Annual Income Breakdown</h3>
        <div class="row"><span class="k">Gross Rental Income</span><span class="v" id="grossIncome">{def.grossIncome}</span></div>
        <div class="row neg"><span class="k">Management Fees</span><span class="v" id="mgmtFees">{def.mgmtFees}</span></div>
        <div class="row neg"><span class="k">Maintenance &amp; Repairs</span><span class="v" id="maintCost">{def.maintCost}</span></div>
        <div class="row neg"><span class="k">Indonesian Withholding Tax</span><span class="v" id="taxCost">{def.taxCost}</span></div>
        <div class="row total"><span class="k">Net Annual Income</span><span class="v" id="netIncome">{def.netIncome}</span></div>
      </div>

      <div class="duo">
        <div class="mini-card glass">
          <div class="lbl">Payback Period</div>
          <div class="val" id="payback">{def.payback}</div>
          <div class="sub">Years to recoup capital</div>
        </div>
        <div class="mini-card glass">
          <div class="lbl">5-Year Net Income</div>
          <div class="val" id="fiveYear">{def.fiveYear}</div>
          <div class="sub">Cumulative net returns</div>
        </div>
      </div>

      <div class="compare glass">
        <h3>How This Compares</h3>
        <div class="bar-row">
          <div class="bar-head"><span>Your Bali villa</span><span class="v" id="youVal">{def.netYield}</span></div>
          <div class="bar-track"><div class="bar-fill you" id="youBar" style="width:87%"></div></div>
        </div>
        <div class="bar-row">
          <div class="bar-head"><span>Dubai residential</span><span class="v">6.5%</span></div>
          <div class="bar-track"><div class="bar-fill bench" data-w="6.5"></div></div>
        </div>
        <div class="bar-row">
          <div class="bar-head"><span>Sydney residential</span><span class="v">3.2%</span></div>
          <div class="bar-track"><div class="bar-fill bench" data-w="3.2"></div></div>
        </div>
        <div class="bar-row">
          <div class="bar-head"><span>Singapore residential</span><span class="v">2.8%</span></div>
          <div class="bar-track"><div class="bar-fill bench" data-w="2.8"></div></div>
        </div>
        <p class="compare-note">Benchmark figures are gross residential yields 2026. Your Bali figure is net after costs.</p>
      </div>

      <div class="calc-cta glass">
        <h3>Want us to find a property that hits these numbers?</h3>
        <p>Book a free 30-minute call. We will show you what is live in the market right now.</p>
        <button type="button" class="btn btn-gold" data-calendly-url={CALENDLY_URL}>Book a Free Call</button>
      </div>

      <p class="disclaimer">This calculator provides indicative estimates only. Actual returns depend on property location, condition, management quality, seasonal occupancy patterns, and market conditions. Figures do not constitute financial advice. Always conduct independent due diligence before investing.</p>
    </div>
  </section>

  <section class="calc-content">
    <div class="container calc-prose">

      <h2>What is a good rental yield in Bali?</h2>
      <p>
        Gross yields average <strong>10.6 percent</strong> across the 511 active listings we track from more than 80 developers.
        That is the number to measure any individual property against. Anything above 12 percent gross is a strong result.
        Well positioned villas in Canggu and Pererenan with an established management operator run 14 to 15 percent.
      </p>
      <p>
        For context, the same capital buys you roughly 3.2 percent in Sydney, 3.6 percent in London and 2.8 percent in Singapore.
        The Bali premium exists because tourism demand supports short-stay nightly rates that residential markets cannot match,
        and because entry prices have not yet caught up with that income potential.
      </p>
      <p>
        Be sceptical of anyone quoting 20 percent as a baseline. That is a projection, not a track record. We only present
        yield figures backed by comparable rental data from properties already operating in the same area.
      </p>

      <h2>Bali rental yields by area</h2>
      <p>
        Yield varies more by area than by property. These are current median entry prices and gross yields across the
        listings we track, as at 2026.
      </p>
      <div class="table-wrap">
        <table class="calc-table">
          <caption class="sr-only">Median entry price and gross rental yield by Bali area, 2026</caption>
          <thead>
            <tr><th scope="col">Area</th><th scope="col">Median entry</th><th scope="col">Gross yield</th><th scope="col">Why</th></tr>
          </thead>
          <tbody>
            {areaYields.map((a) => (
              <tr>
                <th scope="row">{a.area}</th>
                <td>{a.entry}</td>
                <td class="num">{a.gross}</td>
                <td class="note">{a.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        Higher yield is not automatically the better buy. Kedungu returns less today but sits at early pricing, which is
        where capital growth comes from. Uluwatu yields less than Canggu but holds value better and resells faster.
      </p>

      <h2>How to calculate ROI on a Bali villa</h2>
      <p>
        The calculator above runs four steps. You can reproduce them on paper.
      </p>
      <ol class="calc-steps">
        <li><strong>Annual gross income.</strong> Nightly rate multiplied by 365, multiplied by your occupancy rate. At 250 dollars a night and 72 percent occupancy that is 65,700 dollars.</li>
        <li><strong>Gross yield.</strong> Annual gross income divided by purchase price. On a 290,000 dollar villa that is 22.7 percent.</li>
        <li><strong>Deduct real costs.</strong> Management at 15 to 25 percent of rental income, maintenance at 3 to 5 percent of property value per year, and 10 percent withholding tax on rental income for foreign individual owners.</li>
        <li><strong>Net yield and payback.</strong> What is left divided by purchase price gives net yield, 11.9 percent in that example. Purchase price divided by net annual income gives payback, roughly 8.4 years.</li>
      </ol>
      <p>
        The step most buyers skip is the third. A developer brochure quoting a headline yield is almost always quoting gross,
        before management, before maintenance and before tax. The gap between the two is large, and it is the difference
        between a good investment and an average one.
      </p>

      <h2>What this calculator assumes</h2>
      <p>
        Defaults are set to the current market median so the output means something before you change anything.
        Purchase price 290,000 dollars, nightly rate 250 dollars, occupancy 72 percent, management 20 percent,
        maintenance 4 percent of property value, and 10 percent withholding tax.
      </p>
      <p>
        Two things it deliberately does not model. It excludes capital appreciation, because that is a projection rather
        than income, and prime Bali land has historically moved 3 to 5 times over a decade in the strongest areas.
        It also excludes purchase costs such as notary fees and any lease extension premium, which vary by structure.
        Both work in your favour when comparing against the residential markets in the table below, which are also
        quoted gross.
      </p>

      <h2>How Bali compares to other markets</h2>
      <div class="table-wrap">
        <table class="calc-table">
          <caption class="sr-only">Gross rental yield comparison, Bali against major international residential markets, 2026</caption>
          <thead>
            <tr><th scope="col">Market</th><th scope="col">Gross yield</th><th scope="col">Basis</th></tr>
          </thead>
          <tbody>
            {benchmarks.map((b) => (
              <tr>
                <th scope="row">{b.market}</th>
                <td class="num">{b.yieldPct}</td>
                <td class="note">{b.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        Bali carries risks those markets do not: leasehold structures rather than freehold, currency exposure,
        and total dependence on the quality of your management operator. The yield premium is real, and so is the reason for it.
      </p>

      <h2>Frequently asked questions</h2>
      <div class="calc-faq">
        {calcFaqs.map((f) => (
          <details class="calc-faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <p class="calc-next">
        Once the numbers work, the next question is what you can legally buy. Our
        <a href="/journal/can-you-buy-property-in-bali/">interactive ownership guide</a> walks through leasehold, Hak Pakai,
        strata title and PT PMA in four questions. If you are ready to look at live inventory, see
        <a href="/bali-villas-for-sale/">Bali villas for sale</a>.
      </p>

    </div>
  </section>

  <ContactCTA />

  </main>

  <Footer />
  <StickyButton />

</BaseLayout>

<style is:global>
/* ===== Bali ROI Calculator — page-specific styles (redesign 2026) ===== */
.calc-hero{padding:170px 0 60px;text-align:center}
.calc-hero .eyebrow{justify-content:center}
.calc-hero h1,.calc-hero p,.calc-hero .eyebrow{opacity:0;animation:fadeUp .9s var(--ease) forwards}
.calc-hero h1{animation-delay:.1s}
.calc-hero p{animation-delay:.25s;color:var(--text-muted);font-size:1.12rem;max-width:620px;margin:20px auto 0}

.calc-layout{display:grid;grid-template-columns:1fr 1fr;gap:28px;padding:40px 24px 90px;align-items:start}
.panel{padding:38px 34px}
.panel h2{font-size:1.5rem;margin-bottom:26px}

.field{margin-bottom:26px}
.field label{display:block;font-weight:600;font-size:.95rem;margin-bottom:9px}
.input-wrap{position:relative}
.input-wrap .prefix{position:absolute;left:18px;top:50%;transform:translateY(-50%);color:var(--accent);font-weight:600}
.input-wrap input[type="number"]{
  width:100%;padding:15px 18px 15px 38px;font-size:1.05rem;font-weight:600;color:var(--text);
  background:rgba(255,255,255,0.75);border:1px solid var(--glass-border);border-radius:13px;
  font-family:var(--font-body);transition:border-color .25s,box-shadow .25s,background .25s;
  -moz-appearance:textfield;appearance:textfield;
}
.input-wrap input::-webkit-outer-spin-button,.input-wrap input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.input-wrap input:focus{outline:none;border-color:rgba(180,80,42,0.6);box-shadow:0 0 0 4px rgba(180,80,42,0.14);background:#FFFFFF}
.hint{font-size:.83rem;color:var(--text-muted);margin-top:7px}
.range-row{display:flex;justify-content:space-between;font-size:.8rem;color:var(--text-muted);margin-top:8px}
input[type="range"]{
  width:100%;height:6px;border-radius:99px;appearance:none;-webkit-appearance:none;cursor:pointer;
  background:linear-gradient(to right,var(--terra) var(--fill,50%),rgba(122,92,52,0.18) var(--fill,50%));
}
input[type="range"]::-webkit-slider-thumb{
  -webkit-appearance:none;width:24px;height:24px;border-radius:50%;
  background:var(--grad-gold);border:3px solid #FBF7EC;
  box-shadow:0 2px 14px rgba(180,80,42,0.55);transition:transform .2s var(--ease);
}
input[type="range"]::-webkit-slider-thumb:hover{transform:scale(1.15)}
input[type="range"]::-moz-range-thumb{width:22px;height:22px;border-radius:50%;background:#C26430;border:3px solid #FBF7EC;box-shadow:0 2px 14px rgba(180,80,42,0.55)}
input[type="range"]:focus-visible{outline:3px solid rgba(180,80,42,0.5);outline-offset:4px}
.slider-val{color:var(--terra)}
.radio-group{display:flex;flex-direction:column;gap:10px}
.radio-card{
  display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:13px;cursor:pointer;
  background:rgba(255,255,255,0.55);border:1px solid var(--glass-border);
  font-size:.92rem;transition:border-color .25s,background .25s;
}
.radio-card:hover{background:rgba(255,255,255,0.85)}
.radio-card input{accent-color:var(--terra);width:17px;height:17px;flex-shrink:0}
.radio-card.selected{border-color:rgba(180,80,42,0.55);background:rgba(180,80,42,0.08)}

.results{display:flex;flex-direction:column;gap:22px;position:sticky;top:96px}
.yield-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.yield-card{padding:30px 26px;text-align:center;position:relative;overflow:hidden}
.yield-card::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:var(--grad-gold)}
.yield-card.net::before{background:linear-gradient(120deg,#0D5F58,#14A091)}
.yield-card .lbl{font-size:.8rem;letter-spacing:.16em;text-transform:uppercase;color:var(--text-muted)}
.yield-card .val{font-family:var(--font-display);font-size:2.7rem;font-weight:600;margin:8px 0 4px;background:var(--grad-gold);-webkit-background-clip:text;background-clip:text;color:transparent;font-variant-numeric:tabular-nums;transition:opacity .3s}
.yield-card.net .val{background:linear-gradient(120deg,#0D5F58,#0F766E);-webkit-background-clip:text;background-clip:text}
.yield-card .sub{font-size:.83rem;color:var(--text-muted)}
.breakdown{padding:30px 28px}
.breakdown h3{font-size:1.15rem;margin-bottom:18px}
.row{display:flex;justify-content:space-between;gap:14px;padding:11px 0;border-bottom:1px solid rgba(122,92,52,0.12);font-size:.95rem}
.row .k{color:var(--text-muted)}
.row .v{font-weight:600;font-variant-numeric:tabular-nums}
.row.neg .v{color:#A93B26}
.row.total{border-bottom:none;padding-top:16px;font-size:1.05rem}
.row.total .k{color:var(--text);font-weight:600}
.row.total .v{color:var(--teal);font-size:1.15rem}
.mini-card .val{color:var(--accent) !important}
.duo{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.mini-card{padding:26px 24px;text-align:center}
.mini-card .lbl{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted)}
.mini-card .val{font-family:var(--font-display);font-size:1.9rem;font-weight:600;color:var(--gold-light);margin:6px 0 2px;font-variant-numeric:tabular-nums}
.mini-card .sub{font-size:.8rem;color:var(--text-muted)}

.compare{padding:30px 28px}
.compare h3{font-size:1.15rem;margin-bottom:20px}
.bar-row{margin-bottom:16px}
