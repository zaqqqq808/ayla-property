---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_URL, CALENDLY_URL } from '@/config';
import Header from '@/components/Header.astro';
import Testimonials from '@/components/Testimonials.astro';
import Footer from '@/components/Footer.astro';
import StickyButton from '@/components/StickyButton.astro';

const faqs = [
  {
    q: 'Can foreigners buy a villa in Bali?',
    a: 'Yes. You cannot hold freehold land in your own name as a foreign national, but you can hold a villa on Hak Sewa leasehold using nothing more than a passport, on Hak Pakai if you have a stay permit, or through a PT PMA company if you plan to rent it out. We walk you through which structure fits before you commit to anything.',
  },
  {
    q: 'How much does a villa in Bali cost?',
    a: 'The median entry price across the 511 listings we track is around USD 290,000. Realistically the market starts near USD 150,000 for a one bedroom in an emerging area and runs past USD 800,000 for prime Canggu and clifftop Uluwatu. Most of our investor clients transact between USD 250,000 and USD 450,000.',
  },
  {
    q: 'What rental yield can I actually expect?',
    a: 'Gross yields average 10.6 percent across the market we track. Well positioned and well managed villas in Canggu and Pererenan run 14 to 15 percent. Anyone quoting you 20 percent as a baseline is selling you a projection, not a track record. We only present figures backed by comparable rental data.',
  },
  {
    q: 'What does Ayla charge?',
    a: 'Nothing. We are paid a commission by the developer on completion, in the same way a mortgage broker is paid by the lender. You pay no more than going direct, and usually less, because we negotiate the price down first.',
  },
  {
    q: 'Do I need to fly to Bali to buy?',
    a: 'No. A large share of our clients buy remotely. We do the site visits, film walkthroughs, meet the developer, run the due diligence and coordinate an independent notary. Several clients have signed without leaving their kitchen table.',
  },
  {
    q: 'How is Ayla different from the other agencies?',
    a: 'Most Bali agencies either are developers or have exclusive agreements with a handful of them, which means the shortlist you get is the one they are paid to show you. We hold no ties to any developer. We track over 80 of them and recommend whichever genuinely fits your brief.',
  },
];

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
    { "@type": "ListItem", "position": 2, "name": "Bali Villas for Sale", "item": `${SITE_URL}/bali-villas-for-sale/` },
  ]
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
});

const agentSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  "name": "Ayla Property",
  "url": `${SITE_URL}/bali-villas-for-sale/`,
  "areaServed": { "@type": "Place", "name": "Bali, Indonesia" },
  "description": "Independent Bali villa buying agency. We track over 80 developers, hold no exclusivity with any of them, and negotiate on the buyer's behalf.",
  "priceRange": "$$$"
});
---

<BaseLayout
  title="Bali Villas for Sale | Buy a Villa in Bali | Ayla Property"
  description="Looking to buy a villa in Bali? We track 511 listings across 80+ developers, represent none of them, and negotiate on your behalf. Answer three questions to see what fits your budget."
  ogType="website"
  ogImage="/og-image.jpg"
>
  <Fragment slot="head">
    <Fragment set:html={`<script type="application/ld+json">${breadcrumbSchema}</script>`} />
    <Fragment set:html={`<script type="application/ld+json">${faqSchema}</script>`} />
    <Fragment set:html={`<script type="application/ld+json">${agentSchema}</script>`} />
  </Fragment>

  <Header />

  <main class="lp">

    <section class="lp-hero">
      <div class="lp-wrap">
        <span class="lp-eyebrow">Independent buying agency &middot; Bali</span>
        <h1>Bali Villas <span class="grad-text">for Sale</span></h1>
        <p class="lp-lede">
          We are the only buying agency in Bali with no ties to any developer. We track 80+ developers,
          represent none of them, and negotiate on your side, which is how clients get deals the listing sites never show.
        </p>
        <div class="lp-hero-cta">
          <a class="lp-btn lp-btn-gold" href="#matcher">Find my match in 30 seconds</a>
          <a class="lp-btn lp-btn-ghost" href={CALENDLY_URL} target="_blank" rel="noopener">Book a free call</a>
        </div>
        <ul class="lp-trust">
          <li><strong>511</strong><span>Listings tracked</span></li>
          <li><strong>80+</strong><span>Developers monitored</span></li>
          <li><strong>12%+</strong><span>Average client yield</span></li>
          <li><strong>0</strong><span>Developer ties</span></li>
        </ul>
      </div>
    </section>

    <section class="lp-why">
      <div class="lp-wrap">
        <h2>Why buyers use us instead of going direct</h2>
        <div class="lp-why-grid">
          <div class="lp-card">
            <span class="lp-num">01</span>
            <h3>We are genuinely unbiased</h3>
            <p>
              Most Bali agencies are a developer or have exclusivity with a few, so their shortlist is the one they are
              paid to show you. We have no ties to anyone, so if a project is weak, we will say so.
            </p>
          </div>
          <div class="lp-card">
            <span class="lp-num">02</span>
            <h3>We built an algorithm for this</h3>
            <p>
              Our backgrounds are maths, engineering and data science, not estate agency. We built a model that
              scores every developer we track and ranks deals against your brief, not our commission.
            </p>
          </div>
          <div class="lp-card">
            <span class="lp-num">03</span>
            <h3>We actually live here</h3>
            <p>
              Not a two week scouting trip, properly, for years. There is a fair chance our vice president has
              thrown up in a bush behind your future villa, which is why we know which roads flood and what is opening next door.
            </p>
          </div>
          <div class="lp-card">
            <span class="lp-num">04</span>
            <h3>We negotiate, you do not</h3>
            <p>
              We know what developers actually accept on recent units, so we know where the floor is. One client's
              villa went from USD 163,000 to USD 130,000, and valued at USD 180,000 on handover.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-video">
      <div class="lp-wrap">
        <h2>How it works, in 60 seconds</h2>
        <p class="lp-sub">Zaq explains the process from first call to keys.</p>
        <div class="lp-video-card" id="lpVideo" data-yt="T7At3AGvuHo">
          <img src="https://img.youtube.com/vi/T7At3AGvuHo/maxresdefault.jpg" alt="Ayla Property explains how buying a villa in Bali works" loading="lazy" width="1280" height="720" decoding="async" />
          <button type="button" class="lp-play" aria-label="Play video">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
      </div>
    </section>

    <section class="lp-matcher" id="matcher">
      <div class="lp-wrap">
        <h2>What are you actually looking for?</h2>
        <p class="lp-sub">Three questions. We will tell you what fits, what is available, and what it realistically returns.</p>
        <div class="lp-quiz">
          <div class="lp-quiz-top">
            <span class="lp-quiz-kicker">Property matcher</span>
            <button type="button" class="lp-reset" id="lpReset">Start again</button>
          </div>
          <div class="lp-bar"><div class="lp-bar-fill" id="lpBar"></div></div>
          <div class="lp-trail" id="lpTrail"></div>
          <div id="lpStage"></div>
        </div>
      </div>
    </section>

    <Testimonials />

    <section class="lp-faq">
      <div class="lp-wrap lp-narrow">
        <h2>Questions buyers ask before they commit</h2>
        <div class="lp-faq-list">
          {faqs.map((f) => (
            <details class="lp-faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-final">
      <div class="lp-wrap lp-narrow">
        <h2>Tell us what you want. We will go and find it.</h2>
        <p>
          A free 30 minute call, no pitch, no pressure. If Bali is wrong for you we will say that too,
          so you lose half an hour, not USD 300,000.
        </p>
        <div class="lp-hero-cta lp-center">
          <a class="lp-btn lp-btn-gold" href={CALENDLY_URL} target="_blank" rel="noopener">Book your free call</a>
          <a class="lp-btn lp-btn-wa" href="https://wa.me/447928668478" target="_blank" rel="noopener">Message on WhatsApp</a>
        </div>
        <p class="lp-fine">
          New to Bali property? Start with our <a href="/journal/can-you-buy-property-in-bali/">interactive guide to what foreigners can legally buy</a>,
          or model the numbers yourself with the <a href="/bali-roi-calculator/">Bali ROI calculator</a>.
        </p>
      </div>
    </section>

  </main>

  <Footer />
  <StickyButton />

<style is:global>
.lp{--b:#5C2E1F;--o:#2A7A55;--g:#C2A973;--cr:#F5EDE0;--ink:#3A2318;background:#fff;overflow-x:hidden}
.lp-wrap{max-width:1100px;margin:0 auto;padding:0 24px}
.lp-narrow{max-width:760px}
.lp h2{font-family:var(--font-display,Marcellus,Georgia,serif);font-size:2.3rem;line-height:1.18;
color:var(--b);font-weight:400;margin:0 0 14px;letter-spacing:.01em}
.lp h3{font-family:var(--font-display,Marcellus,Georgia,serif);font-weight:400}
.lp-sub{color:rgba(58,35,24,.7);font-size:1.05rem;margin:0 0 34px;max-width:640px}
.lp-eyebrow{display:inline-block;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;
font-weight:700;color:var(--g);margin-bottom:20px}
.lp-hero{padding:150px 0 80px;background:linear-gradient(170deg,#FBF7F0 0%,#F5EDE0 100%);
border-bottom:1px solid rgba(194,169,115,.35)}
.lp-hero h1{font-family:var(--font-display,Marcellus,Georgia,serif);font-size:4rem;line-height:1.05;
color:var(--b);font-weight:400;margin:0 0 22px;letter-spacing:.01em}
.lp-lede{font-size:1.18rem;line-height:1.65;color:rgba(58,35,24,.82);max-width:660px;margin:0 0 32px}
.lp-hero-cta{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:48px}
.lp-center{justify-content:center}
.lp-btn{display:inline-flex;align-items:center;justify-content:center;padding:14px 28px;border-radius:999px;
font-size:.94rem;font-weight:700;text-decoration:none;transition:transform .2s,box-shadow .2s;min-height:50px}
.lp-btn-gold{background:linear-gradient(135deg,#C2A973,#A8873F);color:#FFF8EC;
box-shadow:0 12px 30px -10px rgba(180,80,42,.55)}
.lp-btn-ghost{background:transparent;color:var(--b);border:1.5px solid rgba(92,46,31,.3)}
.lp-btn-wa{background:#25D366;color:#fff;box-shadow:0 12px 30px -10px rgba(37,211,102,.5)}
.lp-trust{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin:0;padding:28px 0 0;
border-top:1px solid rgba(92,46,31,.14);max-width:720px}
.lp-trust li{display:flex;flex-direction:column;gap:3px}
.lp-trust strong{font-family:var(--font-display,Marcellus,Georgia,serif);font-size:2rem;color:var(--o);font-weight:400;line-height:1}
.lp-trust span{font-size:.78rem;color:rgba(58,35,24,.62);letter-spacing:.02em}
.lp-why{padding:88px 0}
.lp-why-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:34px}
.lp-card{background:#FBF9F5;border:1px solid rgba(194,169,115,.35);border-radius:16px;padding:30px 28px}
.lp-num{display:block;font-family:var(--font-display,Marcellus,Georgia,serif);font-size:.9rem;
color:var(--g);letter-spacing:.14em;margin-bottom:12px}
.lp-card h3{font-size:1.3rem;color:var(--b);margin:0 0 10px;line-height:1.25}
.lp-card p{font-size:.95rem;line-height:1.68;color:rgba(58,35,24,.78);margin:0}
.lp-video{padding:0 0 88px}
.lp-video-card{position:relative;border-radius:18px;overflow:hidden;cursor:pointer;aspect-ratio:16/9;
background:#2A1810;box-shadow:0 30px 70px -30px rgba(92,46,31,.5)}
.lp-video-card img{width:100%;height:100%;object-fit:cover;display:block}
.lp-video-card iframe{width:100%;height:100%;border:0;display:block}
.lp-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:76px;height:76px;
border-radius:50%;border:none;background:rgba(194,169,115,.95);color:#3A2318;cursor:pointer;
display:flex;align-items:center;justify-content:center;transition:transform .25s}
.lp-video-card.playing .lp-play{display:none}
.lp-matcher{padding:88px 0;background:linear-gradient(170deg,#FBF7F0,#F5EDE0);
border-top:1px solid rgba(194,169,115,.35);border-bottom:1px solid rgba(194,169,115,.35)}
.lp-quiz{background:#fff;border:1px solid rgba(194,169,115,.4);border-radius:20px;padding:32px 30px;
box-shadow:0 24px 60px -30px rgba(92,46,31,.32)}
.lp-quiz-top{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:20px}
.lp-quiz-kicker{font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:var(--g)}
.lp-reset{background:none;border:1px solid rgba(92,46,31,.25);color:var(--b);font-size:.72rem;
letter-spacing:.06em;text-transform:uppercase;font-weight:600;padding:10px 16px;border-radius:999px;
cursor:pointer;min-height:40px;font-family:inherit}
.lp-bar{height:4px;background:rgba(92,46,31,.12);border-radius:999px;overflow:hidden;margin-bottom:22px}
.lp-bar-fill{height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,var(--g),var(--o));
transition:width .45s cubic-bezier(.4,0,.2,1)}
.lp-trail{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:22px;min-height:26px}
.lp-chip{display:inline-flex;background:rgba(42,122,85,.1);border:1px solid rgba(42,122,85,.28);
color:var(--o);font-size:.72rem;font-weight:600;padding:5px 11px;border-radius:999px}
.lp-qn{font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:rgba(92,46,31,.5);margin-bottom:8px}
.lp-qh{font-size:1.7rem;color:var(--b);margin:0 0 22px;line-height:1.22}
.lp-opts{display:grid;gap:12px;grid-template-columns:1fr}
.lp-opt{text-align:left;background:#fff;border:1.5px solid rgba(92,46,31,.14);border-radius:14px;
padding:17px;cursor:pointer;transition:all .22s;display:flex;flex-direction:column;gap:5px;
width:100%;min-height:58px;font-family:inherit}
.lp-opt:active{transform:scale(.985);border-color:var(--o)}
.lp-opt-t{font-weight:700;font-size:1rem;color:var(--b);line-height:1.3}
.lp-opt-d{font-size:.83rem;color:rgba(58,35,24,.66);line-height:1.5}
.lp-back{margin-top:20px;display:inline-flex;align-items:center;gap:8px;background:#fff;
border:1.5px solid rgba(92,46,31,.22);color:var(--b);font-size:.82rem;font-weight:700;cursor:pointer;
padding:11px 20px;border-radius:999px;min-height:44px;font-family:inherit;transition:all .2s}
.lp-back:before{content:"\2190"}
.lp-badge{display:inline-block;background:var(--o);color:#fff;font-size:.66rem;letter-spacing:.14em;
text-transform:uppercase;font-weight:700;padding:6px 13px;border-radius:999px;margin-bottom:14px}
.lp-rh{font-size:1.9rem;color:var(--b);margin:0 0 10px;line-height:1.18}
.lp-rs{font-size:.98rem;color:rgba(58,35,24,.72);margin:0 0 24px;line-height:1.6}
.lp-rgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-bottom:26px}
.lp-rcard{background:#FBF9F5;border:1px solid rgba(194,169,115,.35);border-radius:14px;padding:20px 18px}
.lp-rk{display:block;font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;
color:var(--g);margin-bottom:10px}
.lp-rcard p{font-size:.9rem;line-height:1.62;color:rgba(58,35,24,.82);margin:0}
.lp-rcta{background:linear-gradient(135deg,var(--b),#4A2419);border-radius:16px;padding:30px 26px;text-align:center;color:var(--cr)}
.lp-rcta-h{font-family:var(--font-display,Marcellus,Georgia,serif);font-size:1.45rem;margin:0 0 8px;color:var(--cr)}
.lp-rcta-p{font-size:.92rem;opacity:.86;margin:0 0 20px}
.lp-faq{padding:88px 0}
.lp-faq-list{margin-top:30px;border-top:1px solid rgba(92,46,31,.14)}
.lp-faq-item{border-bottom:1px solid rgba(92,46,31,.14)}
.lp-faq-item summary{cursor:pointer;padding:20px 0;font-weight:700;font-size:1.04rem;color:var(--b);
list-style:none;display:flex;justify-content:space-between;gap:16px;align-items:center}
.lp-faq-item summary::-webkit-details-marker{display:none}
.lp-faq-item summary:after{content:"+";font-size:1.4rem;color:var(--g);font-weight:400;flex-shrink:0}
.lp-faq-item[open] summary:after{content:"\2013"}
.lp-faq-item p{margin:0 0 22px;font-size:.96rem;line-height:1.72;color:rgba(58,35,24,.8);max-width:640px}
.lp-final{padding:88px 0 100px;background:linear-gradient(170deg,#FBF7F0,#F5EDE0);text-align:center;
border-top:1px solid rgba(194,169,115,.35)}
.lp-final p{font-size:1.06rem;line-height:1.68;color:rgba(58,35,24,.8);max-width:600px;margin:0 auto 30px}
.lp-fine{font-size:.88rem !important;color:rgba(58,35,24,.62) !important;margin-top:28px !important}
.lp-fine a{color:var(--o);text-decoration:none;font-weight:600}
.lp-fade{animation:lpFade .35s ease}
@keyframes lpFade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@media(min-width:640px){.lp-opts.lp-c3{grid-template-columns:repeat(3,1fr)}
.lp-opts.lp-c4{grid-template-columns:repeat(2,1fr)}}
@media(min-width:900px){.lp-opts.lp-c4{grid-template-columns:repeat(4,1fr)}}
@media(hover:hover) and (pointer:fine){
.lp-btn:hover{transform:translateY(-2px)}
.lp-opt:hover{border-color:var(--o);transform:translateY(-3px);box-shadow:0 14px 32px -14px rgba(42,122,85,.45)}
.lp-back:hover,.lp-reset:hover{background:var(--b);color:#FBF7F0;border-color:var(--b)}
.lp-play:hover{transform:translate(-50%,-50%) scale(1.08)}
.lp-fine a:hover{text-decoration:underline}}
@media(max-width:860px){
.lp-hero{padding:100px 0 36px}
.lp-hero h1{font-size:2.9rem}
.lp h2{font-size:1.9rem}
.lp-sub{font-size:.86rem;margin-bottom:22px}
.lp-lede{font-size:1rem;margin-bottom:22px}
.lp-eyebrow{font-size:.63rem;margin-bottom:12px}
.lp-hero-cta{margin-bottom:22px}
.lp-why-grid,.lp-rgrid{grid-template-columns:1fr;gap:12px}
.lp-trust{grid-template-columns:repeat(2,1fr);gap:12px;padding-top:16px}
.lp-trust strong{font-size:1.45rem}
.lp-trust span{font-size:.68rem}
.lp-why,.lp-matcher,.lp-faq{padding:40px 0}
.lp-video{padding:0 0 40px}
.lp-final{padding:40px 0 48px}
.lp-card{padding:18px 16px}
.lp-card h3{font-size:1.15rem;margin:0 0 6px}
.lp-card p{font-size:.86rem;line-height:1.55}
.lp-quiz{padding:20px 16px}
.lp-rs{font-size:.85rem;margin-bottom:16px}
.lp-rcard{padding:14px}
.lp-rcard p{font-size:.83rem}
.lp-faq-item p{font-size:.88rem}
.lp-final p{font-size:.92rem;margin-bottom:18px}
.lp-eyebrow,.lp-hero h1,.lp-lede,.lp h2,.lp-video .lp-sub,.lp-matcher .lp-sub{text-align:center}
.lp-hero .lp-wrap{display:flex;flex-direction:column;align-items:center}
.lp-trust{justify-items:center;text-align:center}
.lp-card{text-align:center}
.lp-quiz-top{justify-content:center;flex-direction:column;text-align:center;gap:8px}}
@media(max-width:560px){
.lp-wrap{padding:0 16px}
.lp-hero{padding:88px 0 28px}
.lp-hero h1{font-size:2.3rem}
.lp-lede{font-size:.92rem;margin-bottom:18px}
.lp h2{font-size:1.6rem}
.lp-sub{font-size:.82rem;margin-bottom:18px}
.lp-qh{font-size:1.35rem}
.lp-rh{font-size:1.5rem}
.lp-quiz{padding:18px 14px;border-radius:14px}
.lp-card{padding:16px 14px}
.lp-btn{width:100%}
.lp-hero-cta{flex-direction:column;gap:10px;margin-bottom:18px}
.lp-trust{gap:10px;padding-top:14px}
.lp-trust strong{font-size:1.25rem}
.lp-trust span{font-size:.64rem}
.lp-play{width:56px;height:56px}
.lp-rgrid{gap:10px}}
@media(prefers-reduced-motion:reduce){.lp *{animation:none !important;transition:none !important}}
</style>

<script is:inline define:vars={{ CALENDLY_URL }}>
(function(){
var WA="https://wa.me/447928668478";
var Q={
goal:{n:"Question 1 of 3",h:"What is this property for?",cols:3,opts:[
{v:"home",t:"A home to live in",d:"You will be there most of the year."},
{v:"roi",t:"Pure investment",d:"You want yield and capital growth, not a bedroom."},
{v:"both",t:"Both",d:"Live in it part of the year, rent it the rest."}]},
type:{n:"Question 2 of 3",h:"What type of property?",cols:4,opts:[
{v:"villa",t:"Villa",d:"Private pool, landed, the Bali default."},
{v:"apartment",t:"Apartment",d:"Lower entry, strata title, less management."},
{v:"townhouse",t:"Townhouse",d:"Smaller footprint, often in gated clusters."},
{v:"commercial",t:"Land or commercial",d:"Padel courts, F&B, wellness, or a plot to build."}]},
budget:{n:"Question 3 of 3",h:"What is your budget?",cols:4,opts:[
{v:"u150",t:"Under $150k",d:"Entry level, emerging areas."},
{v:"150300",t:"$150k to $300k",d:"The busiest bracket in the market."},
{v:"300500",t:"$300k to $500k",d:"Prime areas, stronger build quality."},
{v:"o500",t:"$500k+",d:"Luxury and clifftop."}]}};
var LBL={home:"To live in",roi:"Investment",both:"Live and rent",
villa:"Villa",apartment:"Apartment",townhouse:"Townhouse",commercial:"Land or commercial",
u150:"Under $150k","150300":"$150k to $300k","300500":"$300k to $500k",o500:"$500k+"};
var SUPPLY={villa:{u150:[8,15],"150300":[40,60],"300500":[35,50],o500:[20,30]},
apartment:{u150:[15,25],"150300":[20,30],"300500":[8,14],o500:[3,6]},
townhouse:{u150:[6,12],"150300":[15,25],"300500":[8,14],o500:[3,6]},
commercial:{u150:[4,8],"150300":[8,14],"300500":[8,14],o500:[6,12]}};
var AREAS={u150:"Kedungu, Seseh and the western Bukit. These are the areas still at early pricing, which is where the capital growth sits, but rental infrastructure is thinner so expect a 12 to 18 month ramp up.",
"150300":"Pererenan, Kedungu and the quieter edges of Canggu. This bracket has the deepest inventory on the island and the best balance of yield against entry price.",
"300500":"Canggu, Pererenan and Uluwatu. Established rental demand, year round occupancy and management companies with real track records.",
o500:"Prime Canggu, clifftop Uluwatu and Seminyak. Lower percentage yields than the mid market but the strongest capital preservation and the easiest resale."};
var YIELD={u150:"11 to 13% gross",   "150300":"12 to 15% gross",
"300500":"13 to 15% gross",o500:"9 to 12% gross"};
var st={},path=[];
var stage=document.getElementById("lpStage"),trail=document.getElementById("lpTrail"),bar=document.getElementById("lpBar");
function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}
function nextKey(){if(!st.goal)return "goal";if(!st.type)return "type";if(!st.budget)return "budget";return null;}
function structure(){
if(st.type==="apartment")return "Strata title in your own name if you hold a stay permit, otherwise leasehold. Apartments are the one asset class where foreigners get genuine registered ownership.";
if(st.type==="commercial")return "A PT PMA company holding Hak Guna Bangunan. Commercial operations require a licensed entity, so this route is not optional for you.";
if(st.goal==="roi"||st.goal==="both")return "Leasehold in your own name, then a PT PMA to run the rental business legally. Renting out is a commercial activity and needs the company layer.";
return "Hak Sewa leasehold needs only your passport. If you hold a KITAS or Second Home Visa, Hak Pakai puts a registered title in your own name for up to 80 years.";
}
function drawTrail(){trail.innerHTML=path.map(function(p){return '<span class="lp-chip">'+esc(LBL[st[p]])+'</span>';}).join("");}
function drawBar(){bar.style.width=Math.round(path.length/3*100)+"%";}
function renderQ(k){var d=Q[k];
var h='<div class="lp-fade"><div class="lp-qn">'+d.n+'</div><h3 class="lp-qh">'+d.h+'</h3><div class="lp-opts lp-c'+d.cols+'">';
d.opts.forEach(function(o){h+='<button type="button" class="lp-opt" data-k="'+k+'" data-v="'+o.v+'"><span class="lp-opt-t">'+esc(o.t)+'</span><span class="lp-opt-d">'+esc(o.d)+'</span></button>';});
h+='</div>';
if(path.length)h+='<button type="button" class="lp-back" id="lpBack">Back one step</button>';
h+='</div>';stage.innerHTML=h;}
function renderResult(){
var r=SUPPLY[st.type][st.budget];
var h='<div class="lp-fade lp-result"><span class="lp-badge">Your match</span>';
h+='<h3 class="lp-rh">We typically have '+r[0]+' to '+r[1]+' properties in this bracket</h3>';
h+='<p class="lp-rs">Inventory moves weekly, so treat that as a working range rather than a live count. Here is what the bracket actually looks like.</p>';
h+='<div class="lp-rgrid">';
h+='<div class="lp-rcard"><span class="lp-rk">Where to look</span><p>'+esc(AREAS[st.budget])+'</p></div>';
h+='<div class="lp-rcard"><span class="lp-rk">Realistic yield</span><p>'+esc(YIELD[st.budget])+'. Net of management and running costs, expect roughly two thirds of that figure landing in your account.</p></div>';
h+='<div class="lp-rcard"><span class="lp-rk">Ownership structure</span><p>'+esc(structure())+'</p></div>';
h+='<div class="lp-rcard"><span class="lp-rk">What we would do next</span><p>Send you a shortlist of three to five specific properties with the developer delivery record attached, then negotiate on whichever you want to pursue.</p></div>';
h+='</div>';
h+='<div class="lp-rcta"><p class="lp-rcta-h">Want the actual shortlist?</p><p class="lp-rcta-p">Book a free 30 minute call and we will have specific properties in front of you within a week.</p>';
h+='<div class="lp-hero-cta lp-center"><a class="lp-btn lp-btn-gold" href="'+CALENDLY_URL+'" target="_blank" rel="noopener">Book your free call</a><a class="lp-btn lp-btn-wa" href="'+WA+'" target="_blank" rel="noopener">Message on WhatsApp</a></div></div>';
h+='<button type="button" class="lp-back" id="lpBack">Back one step</button></div>';
stage.innerHTML=h;}
function render(){drawTrail();drawBar();var k=nextKey();if(k)renderQ(k);else renderResult();}
stage.addEventListener("click",function(e){
var b=e.target.closest(".lp-opt");
if(b){var k=b.getAttribute("data-k");st[k]=b.getAttribute("data-v");
if(path.indexOf(k)===-1)path.push(k);render();
var top=document.getElementById("matcher").getBoundingClientRect().top+window.scrollY-80;
if(window.scrollY>top)window.scrollTo({top:top,behavior:"smooth"});return;}
if(e.target.id==="lpBack"){var last=path.pop();if(last)delete st[last];render();}});
document.getElementById("lpReset").addEventListener("click",function(){st={};path=[];render();});
render();
var v=document.getElementById("lpVideo");
if(v)v.addEventListener("click",function(){
var f=document.createElement("iframe");
f.src="https://www.youtube.com/embed/"+v.dataset.yt+"?autoplay=1";
f.title="Ayla Property, how buying a villa in Bali works";
f.allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture";
f.allowFullscreen=true;f.loading="lazy";
v.innerHTML="";v.appendChild(f);v.classList.add("playing");});
})();
</script>
</BaseLayout>
