---
import CalendlyButton from './CalendlyButton.astro';
import { whatsappUrl } from '@/config';
import { listings as allListings, TOTAL_LISTINGS } from '@/data/listings';

interface Props {
  /** Section heading, as HTML. Defaults to the homepage wording. */
  heading?: string;
  /** Intro line under the heading. */
  sub?: string;
  /** Only show listings in these areas. Shows all when omitted. */
  areas?: string[];
  /** Show the closing headline and call button. */
  showClose?: boolean;
}

const { areas, showClose = true } = Astro.props;
const listings = areas ? allListings.filter((l) => areas.includes(l.area)) : allListings;

const {
  heading = `${TOTAL_LISTINGS} listings.<br /><span class="grad-text">These ${listings.length} made the cut.</span>`,
  sub = `We track ${TOTAL_LISTINGS} live listings across Bali. These are our top ${listings.length} right now. We match the other ${TOTAL_LISTINGS - listings.length} to your budget on a call.`,
} = Astro.props;
---
<section class="hot-listings" id="listings">
  <div class="container">
    <div class="reveal section-head">
      <h2 set:html={heading} />
      <p class="section-sub">{sub}</p>
    </div>

    <div class:list={["listing-grid reveal-stagger", { "listing-grid-few": listings.length < 3 }]}>
      {listings.map((l) => (
        <article class="listing-card glass">
          <div class="listing-media">
            <img src={l.image} alt={`${l.title} in ${l.area}`} loading="lazy" width="1000" height="1000" decoding="async" />
            <span class="listing-rank">{String(allListings.indexOf(l) + 1).padStart(2, '0')}</span>
            <span class="listing-area">{l.area}</span>
          </div>
          <div class="listing-body">
            <h3>{l.title}</h3>
            <p class="listing-price">{l.priceUsd} <span>{l.priceIdr}</span></p>
            <ul class="listing-specs">
              {l.specs.map((s) => <li>{s}</li>)}
            </ul>
            <ul class="listing-points">
              {l.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <a
              class="listing-ask"
              href={whatsappUrl(`Hi Ayla, I'd like details on listing ${String(allListings.indexOf(l) + 1).padStart(2, '0')}: the ${l.title} in ${l.area} (${l.priceUsd}).`)}
              target="_blank"
              rel="noopener noreferrer"
            >
              Enquire about this
            </a>
          </div>
        </article>
      ))}
    </div>

    {showClose && (
      <div class="reveal section-head listing-close">
        <h2>Let us find the perfect deal,<br /><span class="grad-text">customised to <span class="u-line">your</span> exact needs.</span></h2>
        <CalendlyButton text="Book a Call" variant="orange" />
      </div>
    )}
  </div>
</section>
