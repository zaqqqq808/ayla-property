---
import CalendlyButton from './CalendlyButton.astro';
import { whatsappUrl } from '@/config';

// Total live listings we track. Update this when the database count changes.
const TOTAL_LISTINGS = 673;

interface Listing {
  title:    string;
  area:     string;
  priceUsd: string;
  priceIdr: string;
  image:    string;
  specs:    string[];
  points:   string[];
}

const listings: Listing[] = [
  {
    title: '2 Bed Villa',
    area: 'Pererenan',
    priceUsd: '$250,000',
    priceIdr: 'Rp 4.5B',
    image: '/listings/listing-01.webp',
    specs: ['2 bed', 'Private pool', 'Rooftop ocean view'],
    points: [
      'Around $2,043 per m²',
      '500 m from Lima Beach',
      'Only 5 villas in the complex',
    ],
  },
  {
    title: '2–4 Bed Villa',
    area: 'Nuanu City',
    priceUsd: 'From $600,000',
    priceIdr: 'Rp 10.8B',
    image: '/listings/listing-02.webp',
    specs: ['2–4 bed', 'Leasehold to 2062', 'Handover Q2 2027'],
    points: [
      'Pink-zone tourism land',
      'PBG building permit already issued',
      'Furnished, run by a hotel operator',
    ],
  },
  {
    title: '1 Bed Villa',
    area: 'Cepaka',
    priceUsd: 'From $99,000',
    priceIdr: 'Rp 1.7B',
    image: '/listings/listing-03.webp',
    specs: ['1 bed', '65 m² build', '30 + 20 yr lease'],
    points: [
      'A furnished villa for under $100K',
      '8 minutes from Pererenan',
      'Yellow-zone land: we explain the rental licensing first',
    ],
  },
  {
    title: '2 Bed Villa',
    area: 'Canggu',
    priceUsd: '$562,500',
    priceIdr: 'Rp 10.1B',
    image: '/listings/listing-04.webp',
    specs: ['2 bed', '284 m² build', 'Fully furnished'],
    points: [
      'Lowest-priced villa still available in the complex',
      '20% down, the rest monthly until handover',
      'Price already includes VAT',
    ],
  },
  {
    title: '2 Bed Villa',
    area: 'Tibubeneng, Canggu',
    priceUsd: '$225,000',
    priceIdr: 'Rp 3.1B',
    image: '/listings/listing-05.webp',
    specs: ['2 bed', 'Private pool', '30 yr lease'],
    points: [
      '110 m² villa on a 97 m² plot',
      'Fully furnished, ready to rent out',
      'Payments tied to construction progress',
    ],
  },
  {
    title: '3 Bed Villa',
    area: 'Sanur',
    priceUsd: '$358,000',
    priceIdr: 'Rp 6.5B',
    image: '/listings/listing-06.webp',
    specs: ['3 bed + optional 4th', 'Private pool', '254 m² build'],
    points: [
      'One of 15 villas around a shared garden',
      'Carport and 128 m² of land included',
      'Sanur: the calmer, family side of Bali',
    ],
  },
];
---
<section class="hot-listings" id="listings">
  <div class="container">
    <div class="reveal section-head">
      <h2>{TOTAL_LISTINGS} listings.<br /><span class="grad-text">These {listings.length} made the cut.</span></h2>
      <p class="section-sub">We track {TOTAL_LISTINGS} live listings across Bali. These are our top {listings.length} right now. We match the other {TOTAL_LISTINGS - listings.length} to your budget on a call.</p>
    </div>

    <div class="listing-grid reveal-stagger">
      {listings.map((l, i) => (
        <article class="listing-card glass">
          <div class="listing-media">
            <img src={l.image} alt={`${l.title} in ${l.area}`} loading="lazy" width="1000" height="1000" decoding="async" />
            <span class="listing-rank">{String(i + 1).padStart(2, '0')}</span>
            <span class="listing-area">{l.area}</span>
          </div>
          <div class="listing-body">
            <h3>{l.title}</h3>
            <p class="listing-price">{l.priceUsd} <span>{l.priceIdr}</span></p>
            <ul class="listing-specs">
              {l.specs.map((s) => <li>{s}</li>)}
            </ul>
            <ul class="listing-points">
              {l.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <a
              class="listing-ask"
              href={whatsappUrl(`Hi Ayla, I'd like details on listing ${String(i + 1).padStart(2, '0')}: the ${l.title} in ${l.area} (${l.priceUsd}).`)}
              target="_blank"
              rel="noopener noreferrer"
            >
              Enquire about this
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="reveal section-head listing-close">
      <h2>Let us find the perfect deal,<br /><span class="grad-text">customised to <span class="u-line">your</span> exact needs.</span></h2>
      <CalendlyButton text="Book a Call" variant="orange" />
    </div>
  </div>
</section>
