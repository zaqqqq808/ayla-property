---
import CalendlyButton from './CalendlyButton.astro';

interface Reason {
  stat:         string;
  title:        string;
  description?: string;
  /* legacy count-up fields, accepted but no longer animated */
  statTo?:      number[];
  statSuffix?:  string;
  statSep?:     string;
}

interface Props {
  eyebrow?:   string;
  titleHtml?: string;
  subtitle?:  string;
  ctaText?:   string;
  reasons?:   Reason[];
}

const defaultReasons: Reason[] = [
  { stat: '17M+', title: 'Tourists Per Year' },
  { stat: '15%+', title: 'Rental Yields' },
  { stat: '10 Yr', title: 'Visa Now Available' },
  { stat: '3–5×', title: 'Capital Appreciation' },
];

const {
  eyebrow   = 'The Opportunity',
  titleHtml = 'Why Smart Investors<br /><span class="grad-text">Choose Bali</span>',
  subtitle  = 'While Western property markets stagnate, Bali continues to deliver exceptional returns driven by surging tourism and limited prime land.',
  ctaText   = 'Find Out If Bali Is Right For You',
  reasons   = defaultReasons,
} = Astro.props;
---
<section class="opportunity">
  <div class="container">
    <div class="reveal section-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2 set:html={titleHtml} />
      <p class="section-sub">{subtitle}</p>
    </div>
    <div class="opp-grid reveal-stagger">
      {reasons.map((reason) => (
        <div class="opp-card glass">
          <div class="num">{reason.stat}</div>
          <h3>{reason.title}</h3>
          {reason.description && <p class="opp-desc">{reason.description}</p>}
        </div>
      ))}
    </div>
    <div class="reveal section-head">
      <CalendlyButton text={ctaText} variant="orange" />
    </div>
  </div>
</section>
