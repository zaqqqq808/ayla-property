---
interface Testimonial {
  quote:    string;
  name:     string;
  location: string;
  initials: string;
}

interface Props {
  eyebrow?:      string;
  title?:        string;
  testimonials?: Testimonial[];
}

const defaultTestimonials: Testimonial[] = [
  {
    quote: "I'd spent two years reading about Bali property and still could not tell the legitimate developers from the ones with bought reviews. Ayla pulled actual delivery records on the projects I was looking at and quietly told me to walk away from two of them. We went with their shortlist. The villa hit 14% gross in year one.",
    name: 'James R.',
    location: 'London, UK',
    initials: 'JR',
  },
  {
    quote: "Honestly, we did not even know Australians could legally buy property in Bali. We'd heard too many horror stories about dodgy lease agreements to just trust someone's word. Ayla got an independent notary to check every clause and we signed the whole thing from our kitchen table in Sydney. Couldn't have been simpler.",
    name: 'Sarah & Tom K.',
    location: 'Sydney, Australia',
    initials: 'SK',
  },
  {
    quote: "My concern was straightforward: I'm in Dubai, who is actually watching the property? Ayla had the management company in place and briefed before we even got the keys. First monthly report came in at 81% occupancy. I haven't had to think about it since!",
    name: 'Marcus D.',
    location: 'Dubai, UAE',
    initials: 'MD',
  },
];

const {
  eyebrow      = 'Client Results',
  title        = 'What Our Investors Say',
  testimonials = defaultTestimonials,
} = Astro.props;

const titleHtml = title === 'What Our Investors Say'
  ? 'What Our <span class="grad-text">Investors Say</span>'
  : title;
---
<section class="testimonials">
  <div class="container">
    <div class="reveal section-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2 set:html={titleHtml} />
    </div>
    <div class="testi-grid reveal-stagger">
      {testimonials.map((t) => (
        <div class="testi-card glass">
          <div class="quote-mark" aria-hidden="true">"</div>
          <p>{t.quote}</p>
          <div class="testi-author">
            <div class="avatar" aria-hidden="true">{t.initials}</div>
            <div>
              <div class="name">{t.name}</div>
              <div class="loc">{t.location}</div>
              <div class="stars" aria-label="5 star rating">★★★★★</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
