---
import CalendlyButton from './CalendlyButton.astro';
import { SITE_URL } from '@/config';

const steps = [
  {
    number: '01',
    title: 'Consultation',
    description:
      "We start with a deep dive into your goals: budget, ROI expectations, lifestyle preferences, and risk tolerance. We understand exactly what you're looking for in Bali.",
  },
  {
    number: '02',
    title: 'Curation',
    description:
      'We access our huge database of Bali developers to find the offers that match your goals. So far, already better than 90% of Bali agencies.',
  },
  {
    number: '03',
    title: 'Research and Negotiation',
    description:
      'We shortlist the favourites and then perform rigourous research on the reputation, quality and reviews of the chosen developers. We then negotiate on your behalf to get the best deal.',
  },
];

const youtubeId = 'T7At3AGvuHo';
const thumbUrl = `https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0`;
---
<section class="method" id="methodology">
  <div class="container">
    <div class="reveal section-head">
      <span class="eyebrow">Our Method</span>
      <h2>Our <span class="grad-text">Method</span></h2>
      <p class="method-intro">We are the first totally agnostic agency in Bali. We gather data on almost every developer in Bali just to find the deal that suits you the most.</p>
      <p class="section-sub">First, watch the video. It's only 1 minute long…</p>
    </div>
    <div class="method-layout">
      <div class="reveal method-video">
        <div
          class="video-card yt-facade"
          data-yt-embed={embedUrl}
          role="button"
          tabindex="0"
          aria-label="Play video: Ayla Property — Our Method"
        >
          <img src={thumbUrl} alt="Ayla Property — Our Method video thumbnail" loading="lazy" width="1280" height="720" decoding="async" />
          <span class="play" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
        </div>
        <p class="video-note">Watch: Our Method in 60 seconds</p>
      </div>
      <div class="steps reveal-stagger">
        {steps.map((step, i) => (
          <div class:list={["step", i === steps.length - 1 ? "step-featured" : "glass"]}>
            <div class="step-num">{step.number}</div>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </div>
        ))}
        <div class="method-cta">
          <CalendlyButton text="Book a Call" variant="gold" />
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Replace YouTube facade with real iframe on click or Enter key
  (function () {
    function activateFacade(el) {
      var embedUrl = el.dataset.ytEmbed;
      if (!embedUrl) return;
      var iframe = document.createElement('iframe');
      iframe.src = embedUrl;
      iframe.title = 'Ayla Property — Our Method';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.innerHTML = '';
      el.appendChild(iframe);
      el.style.cursor = 'default';
    }
    document.querySelectorAll('.yt-facade').forEach(function (el) {
      el.addEventListener('click', function () { activateFacade(el); });
      el.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activateFacade(el);
        }
      });
    });
  })();
</script>

<Fragment set:html={`<script type="application/ld+json">${JSON.stringify({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "How Ayla Property Works — Our Method",
  "description": "A 1-minute overview of how Ayla Property finds, vets and negotiates Bali real estate deals for foreign investors.",
  "thumbnailUrl": thumbUrl,
  "uploadDate": "2025-01-01",
  "duration": "PT1M",
  "embedUrl": `https://www.youtube-nocookie.com/embed/${youtubeId}`,
  "url": `https://www.youtube.com/watch?v=${youtubeId}`,
  "publisher": {
    "@type": "Organization",
    "name": "Ayla Property",
    "url": SITE_URL
  }
})}</script>`} />
