---
const team = [
  { name: 'Silvia', role: 'President',         image: '/images/team-silvia.webp' },
  { name: 'Zaq',    role: 'Vice President',    image: '/images/team-zaq.webp'    },
  { name: 'Willy',  role: 'Real Estate Agent', image: '/images/team-willy.webp'  },
  { name: 'Jackie', role: 'AYLA team mascot',  image: '/images/team-jackie.webp' },
];
---
<section class="team" id="team">
  <div class="container">
    <div class="reveal section-head">
      <span class="eyebrow">The Team</span>
      <h2>Meet the <span class="grad-text">Team</span></h2>
      <p class="section-sub">Our backgrounds include 18 years of real estate, data science, engineering and foraging for rodents</p>
    </div>
    <div class="team-grid reveal-stagger">
      {team.map((member) => (
        <div class="team-card glass">
          <img src={member.image} alt={`Photo of ${member.name}, ${member.role}`} loading="lazy" />
          <div class="team-meta"><h3>{member.name}</h3><div class="role">{member.role}</div></div>
        </div>
      ))}
    </div>
  </div>
</section>
