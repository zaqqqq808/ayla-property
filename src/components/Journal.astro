---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---
<section class="journal" id="journal">
  <div class="container">
    <div class="reveal section-head">
      <span class="eyebrow">Ayla Journal</span>
      <h2>Stay in the <span class="grad-text">Know</span></h2>
    </div>

    {posts.length === 0 ? (
      <p class="section-sub" style="margin:40px auto 0;text-align:center">Posts coming soon.</p>
    ) : (
      <>
        <div class="journal-grid reveal-stagger">
          {posts.map((post) => (
            <a class="journal-card glass" href={`/journal/${post.slug}/`}>
              <span class="date">
                {post.data.publishDate.toLocaleDateString('en-GB', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </span>
              <h3>{post.data.title}</h3>
              <span class="read">Read article
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
          ))}
        </div>
        <div class="journal-more reveal">
          <a class="btn btn-ghost" href="/journal/">View All Articles</a>
        </div>
      </>
    )}
  </div>
</section>
