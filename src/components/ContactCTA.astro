---
import { CALENDLY_URL } from '@/config';
---
<section class="contact-cta" id="contact">
  <div class="container">
    <div class="cta-card glass reveal">
      <span class="eyebrow" style="justify-content:center">Get Started</span>
      <h2>Ready to <span class="grad-text">Invest?</span></h2>
      <p>Book a free 30-minute call with our team. No pressure, no obligation. Just honest advice on whether Bali is the right move for you.</p>
      <button type="button" class="btn btn-gold" data-calendly-url={CALENDLY_URL}>
        Book Your Free 30-Min Call
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
      <p class="cta-fine">Free · No obligation · We reply within 24 hours</p>
    </div>
  </div>
</section>
