---
import CalendlyButton from './CalendlyButton.astro';

const locations = [
  { label: 'Invest in Canggu',    href: '/invest/canggu/' },
  { label: 'Invest in Uluwatu',   href: '/invest/uluwatu/' },
  { label: 'Invest in Pererenan', href: '/invest/pererenan/' },
  { label: 'Invest in Seseh',     href: '/invest/seseh/' },
  { label: 'Invest in Kedungu',   href: '/invest/kedungu/' },
  { label: 'Invest in Sanur',     href: '/invest/sanur/' },
];

const guides = [
  { label: 'Foreigners Buying Guide',         href: '/guides/foreigners-buying-property-bali/' },
  { label: 'Bali Property Investment',        href: '/guides/bali-property-investment/' },
  { label: 'Bali Developer Report 2026',      href: '/guides/bali-developer-report-2026/' },
  { label: 'Foreign Investor Checklist 2026', href: '/guides/indonesia-foreign-investor-checklist-2026/' },
];

const tools = [
  { label: 'Bali ROI Calculator', href: '/bali-roi-calculator/' },
];
---
<header class="nav" id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Ayla Property home">
      <img src="/logo.png" alt="Ayla Property" />
    </a>
    <nav aria-label="Main navigation">
      <ul class="nav-links">
        <li>
          <button class="navlink" aria-haspopup="true">Invest by Location <span class="caret" aria-hidden="true"></span></button>
          <div class="dropdown">
            {locations.map(({ label, href }) => <a href={href}>{label}</a>)}
          </div>
        </li>
        <li><a href="/#methodology">Our Method</a></li>
        <li>
          <button class="navlink" aria-haspopup="true">Guides <span class="caret" aria-hidden="true"></span></button>
          <div class="dropdown">
            {guides.map(({ label, href }) => <a href={href}>{label}</a>)}
          </div>
        </li>
        <li>
          <button class="navlink" aria-haspopup="true">Tools <span class="caret" aria-hidden="true"></span></button>
          <div class="dropdown">
            {tools.map(({ label, href }) => <a href={href}>{label}</a>)}
          </div>
        </li>
        <li><a href="/#contact">Contact</a></li>
        <li><a href="/journal/">Journal</a></li>
        <li class="nav-cta"><CalendlyButton text="Schedule a Call" variant="gold" /></li>
      </ul>
    </nav>
    <button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
<div class="mobile-nav" id="mobileNav">
    <div class="group">
      <div class="group-title">Invest by Location</div>
      {locations.map(({ label, href }) => <a href={href}>{label}</a>)}
    </div>
    <div class="group">
      <div class="group-title">Guides</div>
      {guides.map(({ label, href }) => <a href={href}>{label}</a>)}
    </div>
    <div class="group">
      <div class="group-title">Tools</div>
      {tools.map(({ label, href }) => <a href={href}>{label}</a>)}
    </div>
    <div class="group">
      <a href="/#methodology">Our Method</a>
      <a href="/#contact">Contact</a>
      <a href="/journal/">Journal</a>
    </div>
    <CalendlyButton text="Schedule a Call" variant="gold" />
  </div>

<script is:inline>
  (function () {
    // nav scroll state
    var nav = document.getElementById('nav');
    function onScroll() {
      if (nav) nav.classList.toggle('scrolled', window.scrollY > 24);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // mobile menu
    var toggle = document.getElementById('menuToggle');
    var mobileNav = document.getElementById('mobileNav');
    if (toggle && mobileNav) {
      toggle.addEventListener('click', function () {
        var open = mobileNav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      });
      mobileNav.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          mobileNav.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        });
      });
    }
  })();
</script>
