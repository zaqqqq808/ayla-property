{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/carousel/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "aylaproperty.com"
        }
      ],
      "destination": "https://www.aylaproperty.com/:path*",
      "permanent": true
    },
    {
      "source": "/writer/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-content/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/elementor-page-768/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/listing-inner",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/listing-inner/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/hiddencity-ubud",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/hiddencity-ubud/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed/",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/alpha-villas-mare-nost",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/alpha-villas-mare-nost/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/calypsodmprjct",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/calypsodmprjct/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/2-br-free-hold-villas-ubud/",
      "destination": "/",
      "permanent": true
    }
  ]
}
